# Public (bundled into the app) — never put secrets in EXPO_PUBLIC_*.
# Nest API (same backend as the web marketplace). Physical device: use your PC's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3011
# Next.js web origin that serves product photos (/uploads) and promo images. Defaults to the API host on :3010.
EXPO_PUBLIC_WEB_URL=http://localhost:3010
# true = offline demo data; anything else = live ERP.
EXPO_PUBLIC_USE_MOCK_API=false
