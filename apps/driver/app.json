{
  "expo": {
    "name": "AGCTEK Driver",
    "slug": "agctek-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agctek-driver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture proof-of-delivery photos.",
        "NSPhotoLibraryUsageDescription": "Attach POD photos from your library.",
        "NSLocationWhenInUseUsageDescription": "Share live location with dispatcher tracking while on a trip."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ea580c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach proof-of-delivery photos.",
          "cameraPermission": "Capture proof-of-delivery photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share live location with dispatcher tracking while on a trip."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
