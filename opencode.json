{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "C:\\Users\\AGCTek\\.local\\bin\\serena.exe",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ],
        "enabled": true,
        "timeout": 60000
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": "15%"
  }
}
