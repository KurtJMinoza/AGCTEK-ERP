# Copy of production Traccar conf for AGCTEK (source of truth in repo).
# Deploy to: C:\Program Files\Traccar\conf\traccar.xml then Restart-Service traccar
#
# Flow:
#   VL512 --GT06 TCP--> nginx :5023 --> Traccar 127.0.0.1:15023
#        --JSON forward--> Nest http://127.0.0.1:3011/api/v1/scm/tracking/ingest
#
# Still required for cellular devices:
#   Router WAN TCP 5023 -> this host :5023  (or Cloudflare Spectrum / ngrok tcp)

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <!--
      Position forward → AGCTEK Nest ingest (system of record = GpsLog).

      Primary sample path: native Windows Traccar + Jimi VL512 (GT06 :5023)
      behind nginx stream — see docs/SCM_TRACCAR_VL512.md and
      backend/traccar/nginx-stream-vl512.conf.
      Do not use Docker Compose for that path. Do not use Huabao :5015 for VL512.

      1. Set TRACKING_INGEST_TOKEN (or TRACCAR_INGEST_TOKEN) in backend/.env
         to the same secret used in forward.header below.
      2. Uncomment forward.* after Nest is reachable from this host.
         Same machine: http://127.0.0.1:3011/...
         Nest on another PC: use that machine's LAN IP.
    -->
    <!-- Internal GT06 port when nginx owns public 5023 (Windows VL512 path) -->
    <!--
    <entry key='gt06.port'>25023</entry>
    -->

    <!--
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>http://127.0.0.1:3011/api/v1/scm/tracking/ingest</entry>
    <entry key='forward.header'>X-Traccar-Token: REPLACE_WITH_TRACCAR_INGEST_TOKEN</entry>
    -->

    <!-- Optional: also forward events (ignition, geofence, etc.) to the same URL -->
    <!--
    <entry key='event.forward.type'>json</entry>
    <entry key='event.forward.url'>http://127.0.0.1:3011/api/v1/scm/tracking/ingest</entry>
    <entry key='event.forward.header'>X-Traccar-Token: REPLACE_WITH_TRACCAR_INGEST_TOKEN</entry>
    -->
</properties>
