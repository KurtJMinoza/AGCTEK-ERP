PORT=3011
FRONTEND_URL=https://erp.agctek.co,http://erp.agctek.co,http://localhost:3010

# PostgreSQL database: agcerp
# Update USER and PASSWORD to match your Postgres install
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/agcerp?schema=public"

# Tile38 geofencing (standalone binary — run scripts/start-tile38.ps1; no Docker required)
# Optional legacy: docker compose -f docker-compose.tile38.yml up -d
TILE38_HOST=127.0.0.1
TILE38_PORT=9851
# Origin Tile38 uses to POST enter/exit hooks (code appends /api/v1/scm/tracking/geofence-hook)
TILE38_HOOK_BASE_URL=http://127.0.0.1:3011

# HTTP GPS ingest secret (flespi HTTP stream fallback / curl tools)
# Prefer flespi MQTT for VL502 — docs/SCM_FLESPI_VL502.md
TRACKING_INGEST_TOKEN=change-me-ingest-secret

# Shopper order-tracking map (staff fleet tracking stays live). Seconds.
PUBLIC_TRACKING_DELAY_SECONDS=150
PUBLIC_TRACKING_LAST_MILE_DELAY_SECONDS=60
PUBLIC_TRACKING_STALE_SECONDS=1200
# Shareable tracking links (signed with RETAIL_AUTH_SECRET, audience-scoped). Days.
PUBLIC_TRACKING_LINK_TTL_DAYS=30
# Courier time at each stop ahead of the shopper, for the ETA window
PUBLIC_TRACKING_STOP_SERVICE_SECONDS=300

# Driver may still report delivery damage this long after the trip auto-completes (minutes)
DRIVER_DAMAGE_REPORT_GRACE_MINUTES=60

# Signs shop customer sessions (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RETAIL_AUTH_SECRET=

# Shop Gmail authentication (Google Identity + email OTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
EMAIL_OTP_SECRET=
MAIL_FROM_NAME=AGC Shop
# Usually the same Gmail address as SMTP_USERNAME
MAIL_FROM_ADDRESS=
# Gmail example (App Password required — not your normal Google password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM_ADDRESS=your-account@gmail.com
# SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
# Optional: cap OTP requests per IP per 15 minutes (default 10)
# SHOP_OTP_MAX_REQUESTS_PER_IP=10
# Alias also accepted:
# FLESPI_INGEST_TOKEN=

# flespi MQTT (preferred VL502 path — Nest dials out, no TCP tunnel / Traccar)
# FLESPI_TOKEN=
# Numeric channel id only (e.g. 1438873) — NOT ch….flespi.gw:port
# FLESPI_CHANNEL_ID=1438873
FLESPI_MQTT_HOST=mqtt.flespi.io
FLESPI_MQTT_PORT=8883

# Optional: stamp first vehicle.telematicsDeviceId on prisma db seed
# flespi VL502: 14-digit ident (first 14 of IMEI) or full IMEI
# SEED_VL502_IMEI=86000000000000

# Places autocomplete (Photon / OSM). Public URL is fine for local dev;
# for production, point PLACES_PROVIDER_URL or PHOTON_URL at a self-hosted Photon.
# PLACES_PROVIDER_URL=https://photon.komoot.io
# PHOTON_URL=https://photon.komoot.io

# Route preview (Trip Planning). OSRM owns pathfinding; empty OSRM_BASE_URL = haversine estimate only.
# Public demo server is fine for local dev; self-host OSRM for production (demo is rate-limited, no SLA).
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_MS=5000

# Customer returns: DEMO refund settlement (marks the payment Refunded and the refund PAID).
# Off by default - without FICO no refund may be reported as paid. Set both to true only for demos;
# NEXT_PUBLIC_SD_DEMO_REFUND_PAYMENT (frontend .env.local) shows the "Mark refund paid (demo)" action.
# SD_DEMO_REFUND_PAYMENT=true

# CRM loyalty: real points are earned when an SD invoice is paid (once per sales order).
# Mock accrual (demo / staging) is off by default and always off when NODE_ENV=production:
# mock points are not backed by an invoice.
# LOYALTY_MOCK_ACCRUAL=true enables POST /crm/customers/:id/loyalty/mock-earn (crm.loyalty update).
# LOYALTY_MOCK_ACCRUAL=false
# Points per 100 PHP of an invoice / sales order total (paid-invoice earn and mock earn).
# LOYALTY_POINTS_PER_100_PHP=1
