PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL database: agcerp
# Update USER and PASSWORD to match your Postgres install
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/agcerp?schema=public"

# Tile38 geofencing — prefer standalone binary (docs/SCM_TILE38_STANDALONE.md)
# Optional legacy: docker compose -f docker-compose.tile38.yml up -d
TILE38_HOST=127.0.0.1
TILE38_PORT=9851
# Base URL Tile38 POSTs hooks to (must include /api/v1 global prefix)
TILE38_HOOK_BASE_URL=http://127.0.0.1:3001/api/v1

# HTTP GPS ingest secret (flespi HTTP stream fallback / curl tools)
# Prefer flespi MQTT for VL502 — docs/SCM_FLESPI_VL502.md
TRACKING_INGEST_TOKEN=change-me-ingest-secret
# Alias also accepted:
# FLESPI_INGEST_TOKEN=

# flespi MQTT (preferred VL502 path — Nest dials out, no TCP tunnel)
# FLESPI_TOKEN=
# Numeric channel id only (e.g. 1438873) — NOT ch….flespi.gw:port
# FLESPI_CHANNEL_ID=1438873
FLESPI_MQTT_HOST=mqtt.flespi.io
FLESPI_MQTT_PORT=8883

# Optional: stamp first vehicle.telematicsDeviceId on prisma db seed
# flespi VL502: 14-digit ident (first 14 of IMEI) or full IMEI
# SEED_VL502_IMEI=86000000000000

# Places autocomplete (Photon / OSM). Public URL is fine for local dev;
# for production, point PLACES_PROVIDER_URL or PHOTON_URL at a self-hosted Photon.
# PLACES_PROVIDER_URL=https://photon.komoot.io
# PHOTON_URL=https://photon.komoot.io
