  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  description     String?
  dueDays         Int       @default(30)
  discountDays    Int?
  discountPercent Decimal?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  suppliers       MmSupplier[]
  quotations      MmSupplierQuotation[]
  purchaseOrders  MmPurchaseOrder[]
  purchaseContracts MmPurchaseContract[]

  @@map("mm_payment_terms")
}

model MmSupplierCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  suppliers   MmSupplier[]

  @@map("mm_supplier_categories")
}

model MmSupplier {
  id                  String    @id @default(cuid())
  supplierCode        String    @unique
  supplierName        String
  legalName           String?
  supplierType        String?
  taxId               String?

  primaryContact      String?
  email               String?
  phone               String?
  website             String?

  billingAddress      String?
  shippingAddress     String?
  country             String?
  region              String?

  currencyId          String?
  currency            MmCurrency? @relation("SupplierCurrency", fields: [currencyId], references: [id])
  paymentTermsId      String?
  paymentTerms        MmPaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  deliveryTerms       String?
  defaultWarehouseId  String?
  defaultWarehouse    Warehouse? @relation("SupplierDefaultWh", fields: [defaultWarehouseId], references: [id])
  leadTimeDays        Int?

  taxCode             String?
  taxStatus           String?

  companyId           String
  company             Company @relation(fields: [companyId], references: [id])
  categoryId          String?
  category            MmSupplierCategory? @relation(fields: [categoryId], references: [id])

  status              String    @default("DRAFT")
  qualityInspectionRequired Boolean @default(false)
  /// PREFERRED | APPROVED | BLOCKED | SINGLE_SOURCE | COMPETITIVE_REQUIRED
  sourcingType        String?
  blockReason         String?
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  bankAccounts        MmSupplierBankAccount[]
  supplierMaterials   MmSupplierMaterial[]
  prices              MmSupplierPrice[]
  documents           MmSupplierDocument[]
  audits              MmSupplierAudit[]
  preferredByMaterials MmMaterial[] @relation("MaterialPreferredSupplier")
  batches             MmBatch[]
  prLines             MmPurchaseRequisitionLine[] @relation("PrPreferredSupplier")
  rfqInvites          MmRfqSupplier[]
  quotations          MmSupplierQuotation[]
  rfqAwards           MmRfqAward[]
  purchaseOrders      MmPurchaseOrder[]
  purchaseContracts   MmPurchaseContract[]
  asns                MmAsn[]
  expectedReceipts    MmExpectedReceipt[]
  goodsReceipts       MmGoodsReceipt[] @relation("GrSupplier")
  supplierInvoices    MmSupplierInvoice[]
  evaluations         MmSupplierEvaluation[]
  performanceAlerts   MmSupplierAlert[]
  manualAssessments   MmSupplierManualAssessment[]
  supplierReturns     MmSupplierReturn[]
  procurementSuggestions MmProcurementSuggestion[] @relation("SuggestionPreferredSupplier")

  @@index([status])
  @@index([companyId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("mm_suppliers")
}

model MmSupplierBankAccount {
  id            String    @id @default(cuid())
  supplierId    String
  supplier      MmSupplier @relation(fields: [supplierId], references: [id])
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  swiftCode     String?
  iban          String?
  currency      String?
  isPrimary     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([supplierId])
  @@map("mm_supplier_bank_accounts")
}

model MmSupplierMaterial {
  id                   String    @id @default(cuid())
  supplierId           String
  supplier             MmSupplier @relation(fields: [supplierId], references: [id])
  materialId           String
  material             MmMaterial @relation(fields: [materialId], references: [id])
  supplierMaterialCode String?
  supplierBarcode      String?   @unique
  unitPrice            Decimal   @default(0)
  currencyId           String?
  currency             MmCurrency? @relation("SupMatCurrency", fields: [currencyId], references: [id])
  minimumOrderQuantity Decimal?
  leadTimeDays         Int?
  validityStart        DateTime?
  validityEnd          DateTime?
  preferredSupplier    Boolean   @default(false)
  inspectionRequired   Boolean   @default(false)
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  prices               MmSupplierPrice[]

  @@unique([supplierId, materialId])
  @@index([supplierId])
  @@index([materialId])
  @@map("mm_supplier_materials")
}

model MmSupplierPrice {
  id                 String    @id @default(cuid())
  supplierId         String
  supplier           MmSupplier @relation(fields: [supplierId], references: [id])
  materialId         String
  material           MmMaterial @relation(fields: [materialId], references: [id])
  supplierMaterialId String?
  supplierMaterial   MmSupplierMaterial? @relation(fields: [supplierMaterialId], references: [id])
  unitPrice          Decimal
  currencyId         String?
  currency           MmCurrency? @relation("SupPriceCurrency", fields: [currencyId], references: [id])
  minimumQuantity    Decimal   @default(0)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([supplierId, materialId, effectiveFrom])
  @@index([materialId])
  @@index([deletedAt])
  @@map("mm_supplier_prices")
}

model MmSupplierDocument {
  id          String    @id @default(cuid())
  supplierId  String
  supplier    MmSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String?
  storageKey  String?
  mimeType    String?
  docType     String?
  expiresAt   DateTime?
  isRequiredForPurchasing Boolean @default(false)
  uploadedBy  String?
  uploadedAt  DateTime  @default(now())

  @@index([supplierId])
  @@index([expiresAt])
  @@map("mm_supplier_documents")
}

model MmSupplierAudit {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    MmSupplier @relation(fields: [supplierId], references: [id])
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  performedBy String?
  performedAt DateTime @default(now())
  ipAddress   String?
  details     Json?

  @@index([supplierId])
  @@index([performedAt])
  @@map("mm_supplier_audits")
}

// ΓöÇΓöÇΓöÇ Workflow Engine ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmApprovalWorkflow {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  entityType          String
  approverRole        String
  companyId           String?
  departmentId        String?
  costCenterId        String?
  supplierId          String?
  materialCategoryId  String?
  minAmount           Decimal  @default(0)
  maxAmount           Decimal?
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  instances   MmWorkflowInstance[]

  @@index([entityType, isActive])
  @@index([companyId])
  @@index([supplierId])
  @@map("mm_approval_workflows")
}

model MmWorkflowInstance {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  workflowId  String
  workflow    MmApprovalWorkflow @relation(fields: [workflowId], references: [id])
  status      String    @default("PENDING")
  initiatedBy String?
  initiatedAt DateTime  @default(now())
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       MmApprovalTask[]
  purchaseRequisition MmPurchaseRequisition? @relation("PrWorkflow")
  purchaseOrder       MmPurchaseOrder? @relation("PoWorkflow")

  @@index([entityType, entityId])
  @@index([status])
  @@map("mm_workflow_instances")
}

model MmApprovalTask {
  id          String            @id @default(cuid())
  instanceId  String
  instance    MmWorkflowInstance @relation(fields: [instanceId], references: [id])
  stepNumber  Int
  approverRole String
  approverId  String?
  status      String            @default("PENDING")
  comment     String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([instanceId])
  @@index([status])
  @@map("mm_approval_tasks")
}

// ΓöÇΓöÇΓöÇ Purchase Requisition ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmPurchaseRequisition {
  id                String    @id @default(cuid())
  requisitionNumber String    @unique
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  businessUnitId    String?
  branchId          String?
  departmentId      String?
  costCenterId      String?
  projectId         String?
  requesterId       String
  requiredDate      DateTime
  purpose           String
  status            String    @default("DRAFT")
  approvedBy        String?
  rejectionReason   String?
  returnedReason    String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  budgetValidatedAt DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workflowInstanceId  String?   @unique
  workflowInstance    MmWorkflowInstance? @relation("PrWorkflow", fields: [workflowInstanceId], references: [id])
  lines             MmPurchaseRequisitionLine[]
  conversions       MmPrConversion[]
  audits            MmPurchaseRequisitionAudit[]
  rfqs              MmRfq[]
  purchaseOrders    MmPurchaseOrder[]
  procurementSuggestions MmProcurementSuggestion[]
  plannedOrders     MmPlannedOrder[]
  sourceMrpRunId    String?
  sourceMrpRun      MmMrpRun? @relation("PrSourceMrpRun", fields: [sourceMrpRunId], references: [id])

  @@index([status])
  @@index([companyId])
  @@index([requesterId])
  @@index([sourceMrpRunId])
  @@map("mm_purchase_requisitions")
}

model MmPurchaseRequisitionLine {
  id                  String    @id @default(cuid())
  requisitionId       String
  requisition         MmPurchaseRequisition @relation(fields: [requisitionId], references: [id])
  materialId          String
  material            MmMaterial @relation(fields: [materialId], references: [id])
  description         String
  requestedQuantity   Decimal
  uomId               String
  uom                 MmUom    @relation("PrLineUom", fields: [uomId], references: [id])
  estimatedUnitPrice  Decimal
  estimatedTotal      Decimal
  requiredDate        DateTime
  warehouseId         String?
  warehouse           Warehouse? @relation("PrLineWarehouse", fields: [warehouseId], references: [id])
  preferredSupplierId String?
  preferredSupplier   MmSupplier? @relation("PrPreferredSupplier", fields: [preferredSupplierId], references: [id])
  convertedQty        Decimal  @default(0)
  remarks             String?

  conversions         MmPrConversion[]
  poLines             MmPurchaseOrderLine[]

  @@index([requisitionId])
  @@index([materialId])
  @@map("mm_purchase_requisition_lines")
}

model MmPrConversion {
  id            String    @id @default(cuid())
  requisitionId String
  requisition   MmPurchaseRequisition @relation(fields: [requisitionId], references: [id])
  lineId        String
  line          MmPurchaseRequisitionLine @relation(fields: [lineId], references: [id])
  targetType    String
  targetId      String?
  convertedQty  Decimal
  convertedBy   String?
  convertedAt   DateTime  @default(now())

  @@unique([lineId, targetType])
  @@index([requisitionId])
  @@index([lineId, targetType])
  @@map("mm_pr_conversions")
}

model MmPurchaseRequisitionAudit {
  id            String   @id @default(cuid())
  requisitionId String
  requisition   MmPurchaseRequisition @relation(fields: [requisitionId], references: [id])
  action        String
  field         String?
  oldValue      String?
  newValue      String?
  performedBy   String?
  performedAt   DateTime @default(now())
  details       Json?

  @@index([requisitionId])
  @@index([performedAt])
  @@map("mm_purchase_requisition_audits")
}

// ΓöÇΓöÇΓöÇ RFQ & Supplier Quotations (MM-07) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmRfq {
  id                String    @id @default(cuid())
  rfqNumber         String    @unique
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  buyerId           String
  issueDate         DateTime?
  responseDeadline  DateTime
  currencyId        String?
  currency          MmCurrency? @relation("RfqCurrency", fields: [currencyId], references: [id])
  status            String    @default("DRAFT")
  purpose           String?
  notes             String?
  /// When true, award endpoint may auto-pick lowest total; default false.
  autoSelectCheapest Boolean  @default(false)
  purchaseRequisitionId String?
  purchaseRequisition   MmPurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines             MmRfqLine[]
  invitedSuppliers  MmRfqSupplier[]
  quotations        MmSupplierQuotation[]
  awards            MmRfqAward[]
  audits            MmRfqAudit[]
  purchaseOrders    MmPurchaseOrder[]
  quotationComparisons MmQuotationComparison[]

  @@index([status])
  @@index([companyId])
  @@index([buyerId])
  @@index([responseDeadline])
  @@map("mm_rfqs")
}

model MmRfqLine {
  id              String   @id @default(cuid())
  rfqId           String
  rfq             MmRfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineNumber      Int      @default(1)
  materialId      String
  material        MmMaterial @relation(fields: [materialId], references: [id])
  quantity        Decimal
  uomId           String
  uom             MmUom    @relation("RfqLineUom", fields: [uomId], references: [id])
  requiredDate    DateTime?
  specifications  String?
  prLineId        String?

  quotationLines  MmSupplierQuotationLine[]
  poLines         MmPurchaseOrderLine[]

  @@index([rfqId])
  @@index([materialId])
  @@map("mm_rfq_lines")
}

model MmRfqSupplier {
  id             String   @id @default(cuid())
  rfqId          String
  rfq            MmRfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       MmSupplier @relation(fields: [supplierId], references: [id])
  invitedAt      DateTime @default(now())
  responseStatus String   @default("INVITED") // INVITED | RESPONDED | DECLINED | EXPIRED
  respondedAt    DateTime?
  notes          String?

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@index([supplierId])
  @@index([responseStatus])
  @@map("mm_rfq_suppliers")
}

model MmSupplierQuotation {
  id               String    @id @default(cuid())
  quotationNumber  String    @unique
  rfqId            String
  rfq              MmRfq     @relation(fields: [rfqId], references: [id])
  supplierId       String
  supplier         MmSupplier @relation(fields: [supplierId], references: [id])
  validityDate     DateTime
  currencyId       String?
  currency         MmCurrency? @relation("QuotationCurrency", fields: [currencyId], references: [id])
  paymentTermsId   String?
  paymentTerms     MmPaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  deliveryTerms    String?
  freight          Decimal   @default(0)
  tax              Decimal   @default(0)
  total            Decimal   @default(0)
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | WITHDRAWN | EXPIRED | SELECTED
  qualityScore     Decimal?
  supplierScore    Decimal?
  notes            String?
  submittedAt      DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines            MmSupplierQuotationLine[]
  awards           MmRfqAward[]
  purchaseOrders   MmPurchaseOrder[]

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@index([validityDate])
  @@map("mm_supplier_quotations")
}

model MmSupplierQuotationLine {
  id            String   @id @default(cuid())
  quotationId   String
  quotation     MmSupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineId     String?
  rfqLine       MmRfqLine? @relation(fields: [rfqLineId], references: [id])
  materialId    String
  material      MmMaterial @relation(fields: [materialId], references: [id])
  quantity      Decimal
  uomId         String
  uom           MmUom    @relation("QuotationLineUom", fields: [uomId], references: [id])
  unitPrice     Decimal  @default(0)
  discount      Decimal  @default(0)
  tax           Decimal  @default(0)
  lineTotal     Decimal  @default(0)
  leadTimeDays  Int?
  moq           Decimal?
  warranty      String?
  notes         String?
  /// Optional tiered pricing [{ minQty, unitPrice }]
  pricingTiers  Json?

  poLines       MmPurchaseOrderLine[]

  @@index([quotationId])
  @@index([materialId])
  @@index([rfqLineId])
  @@map("mm_supplier_quotation_lines")
}

model MmRfqAward {
  id              String   @id @default(cuid())
  rfqId           String
  rfq             MmRfq    @relation(fields: [rfqId], references: [id])
  supplierId      String
  supplier        MmSupplier @relation(fields: [supplierId], references: [id])
  quotationId     String?
  quotation       MmSupplierQuotation? @relation(fields: [quotationId], references: [id])
  reason          String
  evaluatedBy     String?
  evaluatedAt     DateTime @default(now())
  autoSelected    Boolean  @default(false)
  createdAt       DateTime @default(now())

  purchaseOrders  MmPurchaseOrder[]

  @@index([rfqId])
  @@index([supplierId])
  @@map("mm_rfq_awards")
}

model MmRfqAudit {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         MmRfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  performedBy String?
  performedAt DateTime @default(now())
  details     Json?

  @@index([rfqId])
  @@index([performedAt])
  @@map("mm_rfq_audits")
}

// ΓöÇΓöÇΓöÇ Purchase Order (MM-08) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmPurchaseOrder {
  id                      String    @id @default(cuid())
  poNumber                String    @unique
  companyId               String
  company                 Company   @relation(fields: [companyId], references: [id])
  branchId                String?
  departmentId            String?
  supplierId              String
  supplier                MmSupplier @relation(fields: [supplierId], references: [id])
  buyerId                 String
  currencyId              String?
  currency                MmCurrency? @relation("PoCurrency", fields: [currencyId], references: [id])
  paymentTermsId          String?
  paymentTerms            MmPaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  deliveryTerms           String?
  warehouseId             String?
  warehouse               Warehouse? @relation("PoWarehouse", fields: [warehouseId], references: [id])
  expectedDeliveryDate    DateTime?
  status                  String    @default("DRAFT")
  totalAmount             Decimal   @default(0)
  purchaseRequisitionId   String?
  purchaseRequisition     MmPurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  rfqId                   String?
  rfq                     MmRfq? @relation(fields: [rfqId], references: [id])
  quotationId             String?
  quotation               MmSupplierQuotation? @relation(fields: [quotationId], references: [id])
  awardId                 String?
  award                   MmRfqAward? @relation(fields: [awardId], references: [id])
  /// Optional per-PO overrides (null = use company MmPoToleranceConfig)
  overDeliveryPctOverride   Decimal?
  underDeliveryPctOverride  Decimal?
  priceTolerancePctOverride Decimal?
  quantityTolerancePctOverride Decimal?
  approvedBy              String?
  approvedAt              DateTime?
  rejectionReason         String?
  returnedReason          String?
  submittedAt             DateTime?
  sentAt                  DateTime?
  closedAt                DateTime?
  cancelledAt             DateTime?
  cancelReason            String?
  purchaseContractId      String?
  purchaseContract        MmPurchaseContract? @relation("PoFromContract", fields: [purchaseContractId], references: [id])
  contractReleaseId       String?   @unique
  contractRelease         MmPurchaseContractRelease? @relation(fields: [contractReleaseId], references: [id])
  revisionNumber          Int       @default(1)
  budgetValidatedAt       DateTime?
  commitmentRecordedAt    DateTime?
  createdBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workflowInstanceId      String?   @unique
  workflowInstance        MmWorkflowInstance? @relation("PoWorkflow", fields: [workflowInstanceId], references: [id])

  lines                   MmPurchaseOrderLine[]
  audits                  MmPurchaseOrderAudit[]
  attachments             MmPurchaseOrderAttachment[]
  goodsReceipts           MmGoodsReceipt[]
  asns                    MmAsn[]
  expectedReceipts        MmExpectedReceipt[]
  supplierInvoices        MmSupplierInvoice[]
  matchExceptions         MmMatchException[]
  purchaseContracts       MmPurchaseContract[]
  commitments             MmPurchaseCommitment[]
  revisions               MmPurchaseOrderRevision[]

  @@index([status])
  @@index([companyId])
  @@index([supplierId])
  @@index([buyerId])
  @@index([purchaseContractId])
  @@map("mm_purchase_orders")
}

model MmPurchaseOrderLine {
  id                  String    @id @default(cuid())
  purchaseOrderId     String
  purchaseOrder       MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber          Int       @default(1)
  materialId          String
  material            MmMaterial @relation(fields: [materialId], references: [id])
  description         String
  quantity            Decimal
  uomId               String
  uom                 MmUom @relation("PoLineUom", fields: [uomId], references: [id])
  unitPrice           Decimal   @default(0)
  discount            Decimal   @default(0)
  tax                 Decimal   @default(0)
  freight             Decimal   @default(0)
  lineTotal           Decimal   @default(0)
  requiredDate        DateTime?
  expectedDeliveryDate DateTime?
  warehouseId         String?
  warehouse           Warehouse? @relation("PoLineWarehouse", fields: [warehouseId], references: [id])
  storageBinId        String?
  storageBin          WmStorageBin? @relation("PoLineBin", fields: [storageBinId], references: [id])
  costCenterId        String?
  projectId           String?
  receivedQuantity    Decimal   @default(0)
  invoicedQuantity    Decimal   @default(0)
  prLineId            String?
  prLine              MmPurchaseRequisitionLine? @relation(fields: [prLineId], references: [id])
  rfqLineId           String?
  rfqLine             MmRfqLine? @relation(fields: [rfqLineId], references: [id])
  quotationLineId     String?
  quotationLine       MmSupplierQuotationLine? @relation(fields: [quotationLineId], references: [id])
  remarks             String?

  goodsReceiptLines   MmGoodsReceiptLine[]
  supplierInvoiceLines MmSupplierInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([materialId])
  @@index([prLineId])
  @@map("mm_purchase_order_lines")
}

model MmPoToleranceConfig {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id])
  overDeliveryPct       Decimal  @default(0)
  underDeliveryPct      Decimal  @default(0)
  priceTolerancePct     Decimal  @default(0)
  quantityTolerancePct  Decimal  @default(0)
  absoluteToleranceAmount Decimal @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("mm_po_tolerance_configs")
}

// ΓöÇΓöÇΓöÇ Purchase Contracts (MM-07) ΓÇö commercial terms only; never posts inventory ΓöÇΓöÇ

model MmPurchaseContract {
  id                  String    @id @default(cuid())
  contractNumber      String    @unique
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  supplierId          String
  supplier            MmSupplier @relation(fields: [supplierId], references: [id])
  buyerId             String
  /// DRAFT | ACTIVE | EXPIRED | CANCELLED
  status              String    @default("DRAFT")
  validFrom           DateTime
  validTo             DateTime?
  currencyId          String?
  currency            MmCurrency? @relation("ContractCurrency", fields: [currencyId], references: [id])
  paymentTermsId      String?
  paymentTerms        MmPaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  deliveryTerms       String?
  materialCategoryId  String?
  materialCategory    MmMaterialCategory? @relation(fields: [materialCategoryId], references: [id])
  /// Optional link to a PO that references these terms (does not create stock)
  purchaseOrderId     String?
  purchaseOrder       MmPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  notes               String?
  createdBy           String?
  activatedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lines               MmPurchaseContractLine[]
  releases            MmPurchaseContractRelease[]
  audits              MmPurchaseContractAudit[]
  posFromContract     MmPurchaseOrder[] @relation("PoFromContract")

  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseOrderId])
  @@map("mm_purchase_contracts")
}

model MmPurchaseContractLine {
  id              String    @id @default(cuid())
  contractId      String
  contract        MmPurchaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lineNumber      Int       @default(1)
  materialId      String
  material        MmMaterial @relation(fields: [materialId], references: [id])
  uomId           String
  uom             MmUom     @relation("ContractLineUom", fields: [uomId], references: [id])
  contractQuantity Decimal  @default(0)
  releasedQuantity Decimal  @default(0)
  negotiatedPrice Decimal   @default(0)
  moq             Decimal?
  leadTimeDays    Int?
  remarks         String?

  releaseLines    MmPurchaseContractReleaseLine[]

  @@index([contractId])
  @@index([materialId])
  @@map("mm_purchase_contract_lines")
}

model MmPurchaseContractRelease {
  id              String    @id @default(cuid())
  releaseNumber   String    @unique
  contractId      String
  contract        MmPurchaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status          String    @default("RELEASED")
  releasedAt      DateTime  @default(now())
  releasedBy      String?
  notes           String?
  createdAt       DateTime  @default(now())

  lines           MmPurchaseContractReleaseLine[]
  purchaseOrder   MmPurchaseOrder?

  @@index([contractId])
  @@index([releasedAt])
  @@map("mm_purchase_contract_releases")
}

model MmPurchaseContractReleaseLine {
  id              String    @id @default(cuid())
  releaseId       String
  release         MmPurchaseContractRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  contractLineId  String
  contractLine    MmPurchaseContractLine @relation(fields: [contractLineId], references: [id])
  quantity        Decimal

  @@index([releaseId])
  @@index([contractLineId])
  @@map("mm_purchase_contract_release_lines")
}

model MmPurchaseContractAudit {
  id            String   @id @default(cuid())
  contractId    String
  contract      MmPurchaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  action        String
  field         String?
  oldValue      String?
  newValue      String?
  performedBy   String?
  performedAt   DateTime @default(now())
  details       Json?

  @@index([contractId])
  @@index([performedAt])
  @@map("mm_purchase_contract_audits")
}

model MmPurchaseCommitment {
  id              String    @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  companyId       String
  amount          Decimal
  currencyId      String?
  /// OPEN | RELEASED | CANCELLED — FICO integration boundary
  status          String    @default("OPEN")
  committedAt     DateTime  @default(now())
  releasedAt      DateTime?
  externalRef     String?
  createdBy       String?

  @@index([purchaseOrderId])
  @@index([companyId])
  @@index([status])
  @@map("mm_purchase_commitments")
}

model MmPurchaseOrderRevision {
  id              String    @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  revisionNumber  Int
  reason          String?
  snapshot        Json
  revisedBy       String?
  revisedAt       DateTime  @default(now())

  @@unique([purchaseOrderId, revisionNumber])
  @@index([purchaseOrderId])
  @@map("mm_purchase_order_revisions")
}

model MmQuotationComparison {
  id                    String    @id @default(cuid())
  rfqId                 String
  rfq                   MmRfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  comparedBy            String?
  comparedAt            DateTime  @default(now())
  criteria              Json?
  results               Json
  selectedQuotationId   String?
  selectionReason       String?

  @@index([rfqId])
  @@index([comparedAt])
  @@map("mm_quotation_comparisons")
}

model MmPurchaseOrderAudit {
  id            String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  action        String
  field         String?
  oldValue      String?
  newValue      String?
  performedBy   String?
  performedAt   DateTime @default(now())
  details       Json?

  @@index([purchaseOrderId])
  @@index([performedAt])
  @@map("mm_purchase_order_audits")
}

model MmPurchaseOrderAttachment {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String?
  storageKey      String?
  uploadedBy      String?
  uploadedAt      DateTime @default(now())

  @@index([purchaseOrderId])
  @@map("mm_purchase_order_attachments")
}

// ΓöÇΓöÇΓöÇ Inbound: ASN / Expected Receipt / Quality (MM-09) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmAsn {
  id              String   @id @default(cuid())
  asnNumber       String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  supplierId      String
  supplier        MmSupplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   MmPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String?
  warehouse       Warehouse? @relation("AsnWarehouse", fields: [warehouseId], references: [id])
  /// Supplier shipment identity
  shipmentNumber  String?
  carrier         String?
  trackingNumber  String?
  supplierReference String?
  packageCount    Int?
  expectedDate    DateTime?
  status          String   @default("DRAFT") // DRAFT | CONFIRMED | CANCELLED
  remarks         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           MmAsnLine[]
  expectedReceipts MmExpectedReceipt[]
  goodsReceipts   MmGoodsReceipt[]

  @@index([status])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@map("mm_asns")
}

model MmAsnLine {
  id              String   @id @default(cuid())
  asnId           String
  asn             MmAsn    @relation(fields: [asnId], references: [id], onDelete: Cascade)
  materialId      String
  material        MmMaterial @relation(fields: [materialId], references: [id])
  quantity        Decimal
  uomId           String
  uom             MmUom @relation("AsnLineUom", fields: [uomId], references: [id])
  purchaseOrderLineId String?
  /// Foresight only ΓÇö posting uses GR batch/serial FKs
  batchNumber     String?
  serialNumber    String?
  packageType     String?
  grossWeight     Decimal?
  remarks         String?

  @@index([asnId])
  @@map("mm_asn_lines")
}

model MmExpectedReceipt {
  id              String   @id @default(cuid())
  documentNumber  String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  supplierId      String
  supplier        MmSupplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   MmPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  asnId           String?
  asn             MmAsn? @relation(fields: [asnId], references: [id])
  warehouseId     String
  warehouse       Warehouse @relation("ExpectedReceiptWarehouse", fields: [warehouseId], references: [id])
  expectedDate    DateTime?
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED | CANCELLED
  sourceType      String   // PO | ASN
  remarks         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           MmExpectedReceiptLine[]
  goodsReceipts   MmGoodsReceipt[]
  receivingDocuments MmReceivingDocument[]

  @@index([status])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@map("mm_expected_receipts")
}

model MmExpectedReceiptLine {
  id                String   @id @default(cuid())
  expectedReceiptId String
  expectedReceipt   MmExpectedReceipt @relation(fields: [expectedReceiptId], references: [id], onDelete: Cascade)
  materialId        String
  material          MmMaterial @relation(fields: [materialId], references: [id])
  expectedQuantity  Decimal
  receivedQuantity  Decimal  @default(0)
  damagedQuantity   Decimal  @default(0)
  rejectedQuantity  Decimal  @default(0)
  uomId             String
  uom               MmUom @relation("ErLineUom", fields: [uomId], references: [id])
  purchaseOrderLineId String?
  asnLineId         String?
  status            String   @default("OPEN") // OPEN | PARTIAL | COMPLETE | SHORT | OVER
  remarks           String?
  goodsReceiptLines MmGoodsReceiptLine[]

  @@index([expectedReceiptId])
  @@map("mm_expected_receipt_lines")
}

model MmQualityInspection {
  id              String   @id @default(cuid())
  inspectionNumber String  @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  goodsReceiptId  String
  goodsReceipt    MmGoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  warehouseId     String
  status          String   @default("PENDING") // PENDING | COMPLETED | CANCELLED
  result          String?  // PASS | FAIL | PARTIAL_PASS
  inspectedBy     String?
  inspectedAt     DateTime?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           MmQualityInspectionLine[]

  @@index([status])
  @@index([goodsReceiptId])
  @@map("mm_quality_inspections")
}

model MmQualityInspectionLine {
  id                    String   @id @default(cuid())
  inspectionId          String
  inspection            MmQualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  goodsReceiptLineId    String
  goodsReceiptLine      MmGoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id])
  materialId            String
  quantity              Decimal
  passQuantity          Decimal  @default(0)
  failQuantity          Decimal  @default(0)
  result                String?  // PASS | FAIL | PARTIAL_PASS
  remarks               String?

  @@index([inspectionId])
  @@map("mm_quality_inspection_lines")
}

// ─── Receiving session + typed variances (MM-07 Phase 3) ───

model MmReceivingDocument {
  id                  String   @id @default(cuid())
  documentNumber      String   @unique
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  expectedReceiptId   String
  expectedReceipt     MmExpectedReceipt @relation(fields: [expectedReceiptId], references: [id])
  warehouseId         String
  warehouse           Warehouse @relation("ReceivingDocWarehouse", fields: [warehouseId], references: [id])
  purchaseOrderId     String?
  asnId               String?
  supplierId          String?
  /// DRAFT | VALIDATED | POSTED | CANCELLED
  status              String   @default("DRAFT")
  receiverId          String?
  postingDate         DateTime?
  documentDate        DateTime?
  validatedAt         DateTime?
  validatedBy         String?
  postedAt            DateTime?
  postedBy            String?
  goodsReceiptId      String?
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lines               MmReceivingLine[]
  variances           MmReceivingVariance[]
  goodsReceipt        MmGoodsReceipt?

  @@index([status])
  @@index([expectedReceiptId])
  @@index([companyId])
  @@map("mm_receiving_documents")
}

model MmReceivingLine {
  id                    String   @id @default(cuid())
  receivingDocumentId   String
  receivingDocument     MmReceivingDocument @relation(fields: [receivingDocumentId], references: [id], onDelete: Cascade)
  lineNumber            Int      @default(1)
  expectedReceiptLineId String
  materialId            String
  material              MmMaterial @relation(fields: [materialId], references: [id])
  receivedQuantity      Decimal
  damagedQuantity       Decimal  @default(0)
  rejectedQuantity      Decimal  @default(0)
  uomId                 String
  uom                   MmUom @relation("ReceivingLineUom", fields: [uomId], references: [id])
  storageBinId          String?
  batchId               String?
  serialNumberId        String?
  unitCost              Decimal  @default(0)
  barcode               String?
  remarks               String?

  variances             MmReceivingVariance[]

  @@index([receivingDocumentId])
  @@index([expectedReceiptLineId])
  @@map("mm_receiving_lines")
}

model MmReceivingVariance {
  id                  String   @id @default(cuid())
  receivingDocumentId String
  receivingDocument   MmReceivingDocument @relation(fields: [receivingDocumentId], references: [id], onDelete: Cascade)
  receivingLineId     String?
  receivingLine       MmReceivingLine? @relation(fields: [receivingLineId], references: [id], onDelete: SetNull)
  /// UNDER_RECEIPT | OVER_RECEIPT | DAMAGED | UNEXPECTED_ITEM | BATCH_MISMATCH | SERIAL_MISMATCH | UOM_MISMATCH
  varianceType        String
  quantity            Decimal  @default(0)
  description         String?
  /// OPEN | ACKNOWLEDGED | RESOLVED
  status              String   @default("OPEN")
  detectedAt          DateTime @default(now())
  resolvedAt          DateTime?
  resolvedBy          String?

  @@index([receivingDocumentId])
  @@index([varianceType])
  @@index([status])
  @@map("mm_receiving_variances")
}

// ─── Inspection lots + quality holds (MM-07 Phase 3) ───

model MmInspectionPlan {
  id                  String   @id @default(cuid())
  planCode            String   @unique
  name                String
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  materialCategoryId  String?
  materialCategory    MmMaterialCategory? @relation(fields: [materialCategoryId], references: [id])
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  characteristics     MmInspectionCharacteristic[]
  inspectionLots      MmInspectionLot[]

  @@index([companyId])
  @@map("mm_inspection_plans")
}

model MmInspectionCharacteristic {
  id              String   @id @default(cuid())
  planId          String
  plan            MmInspectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  lineNumber      Int      @default(1)
  name            String
  /// NUMERIC | TEXT | BOOLEAN
  valueType       String   @default("NUMERIC")
  toleranceMin    Decimal?
  toleranceMax    Decimal?
  required        Boolean  @default(true)
  unit            String?

  results         MmInspectionResult[]

  @@index([planId])
  @@map("mm_inspection_characteristics")
}

model MmInspectionLot {
  id                        String   @id @default(cuid())
  lotNumber                 String   @unique
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id])
  goodsReceiptId            String
  goodsReceipt              MmGoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptLineId        String
  materialId                String
  material                  MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId               String
  warehouse                 Warehouse @relation("InspectionLotWarehouse", fields: [warehouseId], references: [id])
  quantity                  Decimal
  planId                    String?
  plan                      MmInspectionPlan? @relation(fields: [planId], references: [id])
  legacyQualityInspectionId String?  @unique
  /// PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  status                    String   @default("PENDING")
  result                    String?
  inspectedBy               String?
  inspectedAt               DateTime?
  remarks                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  samples                   MmInspectionSample[]
  results                   MmInspectionResult[]
  defects                   MmInspectionDefect[]
  qualityHolds              MmQualityHold[]
  decisions                 MmQualityDecision[]

  @@index([status])
  @@index([goodsReceiptId])
  @@index([goodsReceiptLineId])
  @@index([companyId])
  @@map("mm_inspection_lots")
}

model MmInspectionSample {
  id              String   @id @default(cuid())
  inspectionLotId String
  inspectionLot   MmInspectionLot @relation(fields: [inspectionLotId], references: [id], onDelete: Cascade)
  sampleNumber    Int      @default(1)
  sampleSize      Decimal
  notes           String?
  createdAt       DateTime @default(now())

  results         MmInspectionResult[]

  @@index([inspectionLotId])
  @@map("mm_inspection_samples")
}

model MmInspectionResult {
  id                String   @id @default(cuid())
  inspectionLotId   String
  inspectionLot     MmInspectionLot @relation(fields: [inspectionLotId], references: [id], onDelete: Cascade)
  sampleId          String?
  sample            MmInspectionSample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  characteristicId  String?
  characteristic    MmInspectionCharacteristic? @relation(fields: [characteristicId], references: [id], onDelete: SetNull)
  measuredValue     String?
  numericValue      Decimal?
  passed            Boolean?
  notes             String?
  recordedBy        String?
  recordedAt        DateTime @default(now())

  @@index([inspectionLotId])
  @@map("mm_inspection_results")
}

model MmInspectionDefect {
  id              String   @id @default(cuid())
  inspectionLotId String
  inspectionLot   MmInspectionLot @relation(fields: [inspectionLotId], references: [id], onDelete: Cascade)
  defectCode      String
  quantity        Decimal  @default(0)
  severity        String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([inspectionLotId])
  @@map("mm_inspection_defects")
}

model MmQualityHold {
  id              String   @id @default(cuid())
  holdNumber      String   @unique
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  inspectionLotId String?
  inspectionLot   MmInspectionLot? @relation(fields: [inspectionLotId], references: [id])
  goodsReceiptLineId String?
  materialId      String?
  warehouseId     String?
  /// ACTIVE | RELEASED
  status          String   @default("ACTIVE")
  reason          String
  heldBy          String?
  heldAt          DateTime @default(now())
  releasedBy      String?
  releasedAt      DateTime?
  releaseNotes    String?

  @@index([status])
  @@index([inspectionLotId])
  @@index([companyId])
  @@map("mm_quality_holds")
}

model MmQualityDecision {
  id              String   @id @default(cuid())
  inspectionLotId String
  inspectionLot   MmInspectionLot @relation(fields: [inspectionLotId], references: [id], onDelete: Cascade)
  /// ACCEPT | ACCEPT_WITH_DEVIATION | REJECT | REWORK | RETURN
  decisionCode    String
  quantity        Decimal
  deviationReason String?
  decidedBy       String?
  decidedAt       DateTime @default(now())
  targetStockStatus String?
  supplierReturnId String?
  supplierReturn  MmSupplierReturn? @relation(fields: [supplierReturnId], references: [id])
  notes           String?

  @@index([inspectionLotId])
  @@index([supplierReturnId])
  @@map("mm_quality_decisions")
}

model MmAccountingEvent {
  id              String   @id @default(cuid())
  eventType       String
  sourceModule    String
  documentType    String
  documentId      String
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  payload         Json
  status          String   @default("PENDING") // PENDING | CONSUMED | FAILED
  createdAt       DateTime @default(now())
  consumedAt      DateTime?

  @@index([documentType, documentId])
  @@index([status])
  @@map("mm_accounting_events")
}

// ΓöÇΓöÇΓöÇ Inventory Control (Cycle Count / Physical Inventory) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmCountRule {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  companyId              String?
  company                Company?  @relation(fields: [companyId], references: [id])
  warehouseId            String?
  warehouse              Warehouse? @relation(fields: [warehouseId], references: [id])
  /// A | B | C
  abcClass               String?
  /// FAST | MEDIUM | SLOW
  velocityClass          String?
  /// LOW | MEDIUM | HIGH
  riskClass              String?
  materialCategoryId     String?
  materialTypeId         String?
  /// Days between counts (e.g. 7 weekly, 30 monthly, 90 quarterly)
  frequencyDays          Int       @default(30)
  varianceQtyTolerance   Decimal   @default(0)
  varianceValueTolerance Decimal   @default(0)
  /// Value band filter on material.standardCost
  minUnitValue           Decimal?
  maxUnitValue           Decimal?
  priority               Int       @default(5)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  counts                 MmInventoryCount[]
  canonicalPolicy        MmCountPolicy?

  @@index([warehouseId])
  @@index([abcClass])
  @@index([velocityClass])
  @@index([riskClass])
  @@index([isActive])
  @@map("mm_count_rules")
}

model MmInventoryCount {
  id             String    @id @default(cuid())
  countNumber    String    @unique
  /// CYCLE | PHYSICAL
  countType      String
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  ruleId         String?
  rule           MmCountRule? @relation(fields: [ruleId], references: [id])
  /// OPEN | COUNTING | RECOUNT | APPROVAL | POSTED | CLOSED
  status         String    @default("OPEN")
  dueDate        DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lines          MmInventoryCountLine[]
  adjustment     MmInventoryAdjustment?
  canonicalPlan  MmCountPlan?

  @@index([status])
  @@index([warehouseId])
  @@index([countType])
  @@map("mm_inventory_counts")
}

model MmInventoryCountLine {
  id                   String   @id @default(cuid())
  countId              String
  count                MmInventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  lineNumber           Int
  storageBinId         String?
  storageBin           WmStorageBin? @relation(fields: [storageBinId], references: [id])
  materialId           String
  material             MmMaterial @relation(fields: [materialId], references: [id])
  batchId              String?
  serialNumberId       String?
  systemQuantity       Decimal  @default(0)
  countedQuantity      Decimal?
  recountQuantity      Decimal?
  finalQuantity        Decimal?
  varianceQuantity     Decimal  @default(0)
  varianceValue        Decimal  @default(0)
  unitCost             Decimal  @default(0)
  assignedCounter      String?
  /// PENDING | COUNTED | REQUIRE_RECOUNT | RECOUNTED | APPROVED | REJECTED | ADJUSTED
  status               String   @default("PENDING")
  lastIdempotencyKey   String?  @unique
  countedBy            String?
  countedAt            DateTime?
  recountBy            String?
  recountedAt          DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  originalCount        Decimal?
  finalAdjustmentQty   Decimal?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([countId])
  @@index([status])
  @@index([materialId])
  @@index([assignedCounter])
  @@map("mm_inventory_count_lines")
}

// ─── Phase 7: Canonical Inventory Control Count Engine ───────────────

model MmCountReasonCode {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adjustmentLines MmCountAdjustmentRequestLine[]

  @@unique([companyId, code])
  @@index([isActive])
  @@map("mm_count_reason_codes")
}

model MmCountPolicy {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  companyId              String?
  company                Company?  @relation(fields: [companyId], references: [id])
  warehouseId            String?
  warehouse              Warehouse? @relation(fields: [warehouseId], references: [id])
  /// A | B | C
  abcClass               String?
  velocityClass          String?
  riskClass              String?
  materialCategoryId     String?
  materialTypeId         String?
  /// Configurable days between counts (engine reads; does not hard-code business defaults)
  frequencyDays          Int       @default(30)
  varianceQtyTolerance   Decimal   @default(0)
  variancePctTolerance   Decimal   @default(0)
  varianceValueTolerance Decimal   @default(0)
  minUnitValue           Decimal?
  maxUnitValue           Decimal?
  blindCountRequired     Boolean   @default(false)
  priority               Int       @default(5)
  isActive               Boolean   @default(true)
  legacyCountRuleId      String?   @unique
  legacyCountRule        MmCountRule? @relation(fields: [legacyCountRuleId], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  plans                  MmCountPlan[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([abcClass])
  @@index([isActive])
  @@map("mm_count_policies")
}

model MmCountPlan {
  id                     String    @id @default(cuid())
  planNumber             String    @unique
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  policyId               String?
  policy                 MmCountPolicy? @relation(fields: [policyId], references: [id])
  /// CYCLE_COUNT | PHYSICAL_INVENTORY | BLIND_COUNT | RECOUNT
  countType              String
  /// PLANNED | OPEN | IN_PROGRESS | COUNTED | VARIANCE | RECOUNT_REQUIRED | PENDING_APPROVAL | APPROVED | REJECTED | ADJUSTED | CLOSED
  status                 String    @default("PLANNED")
  dueDate                DateTime?
  plannedStart           DateTime?
  plannedEnd             DateTime?
  notes                  String?
  createdBy              String?
  legacyInventoryCountId String?   @unique
  legacyInventoryCount   MmInventoryCount? @relation(fields: [legacyInventoryCountId], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  sessions               MmCountSession[]

  @@index([companyId, status])
  @@index([warehouseId, status])
  @@index([policyId])
  @@index([countType])
  @@map("mm_count_plans")
}

model MmCountSession {
  id            String    @id @default(cuid())
  sessionNumber String    @unique
  planId        String
  plan          MmCountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  countType     String
  status        String    @default("OPEN")
  blindMode     Boolean   @default(false)
  startedAt     DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tasks         MmCountTask[]
  adjustmentRequests MmCountAdjustmentRequest[]

  @@index([planId])
  @@index([warehouseId, status])
  @@index([companyId, status])
  @@map("mm_count_sessions")
}

model MmCountTask {
  id              String   @id @default(cuid())
  sessionId       String
  session         MmCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskNumber      Int
  materialId      String
  material        MmMaterial @relation(fields: [materialId], references: [id])
  storageBinId    String?
  storageBin      WmStorageBin? @relation(fields: [storageBinId], references: [id])
  batchId         String?
  serialNumberId  String?
  uomId           String
  systemQuantity  Decimal  @default(0)
  unitCost        Decimal  @default(0)
  assignedCounter String?
  /// PENDING | COUNTED | VARIANCE | RECOUNT_REQUIRED | APPROVED | REJECTED | ADJUSTED
  status          String   @default("PENDING")
  lastCountedAt   DateTime?
  lastIdempotencyKey String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  entries         MmCountEntry[]
  variances       MmCountVariance[]
  recounts        MmCountRecount[]
  adjustmentLines MmCountAdjustmentRequestLine[]

  @@unique([sessionId, taskNumber])
  @@index([sessionId, status])
  @@index([materialId, updatedAt])
  @@index([assignedCounter])
  @@map("mm_count_tasks")
}

model MmCountEntry {
  id            String   @id @default(cuid())
  taskId        String
  task          MmCountTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sequence      Int
  countQuantity Decimal
  uomId         String
  counterId     String?
  countedAt     DateTime @default(now())
  notes         String?
  isBlind       Boolean  @default(false)
  attachmentMeta Json?
  idempotencyKey String? @unique
  createdAt     DateTime @default(now())
  variances     MmCountVariance[]

  @@unique([taskId, sequence])
  @@index([taskId])
  @@map("mm_count_entries")
}

model MmCountVariance {
  id                 String   @id @default(cuid())
  taskId             String
  task               MmCountTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entryId            String?
  entry              MmCountEntry? @relation(fields: [entryId], references: [id])
  systemQuantity     Decimal
  countQuantity      Decimal
  varianceQuantity   Decimal
  variancePercentage Decimal  @default(0)
  estimatedValue     Decimal  @default(0)
  unitCost           Decimal  @default(0)
  /// OPEN | RECOUNT_REQUIRED | CLEARED | PENDING_ADJUSTMENT | ADJUSTED
  status             String   @default("OPEN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recounts           MmCountRecount[]
  adjustmentLines    MmCountAdjustmentRequestLine[]

  @@index([taskId])
  @@index([status])
  @@map("mm_count_variances")
}

model MmCountRecount {
  id          String    @id @default(cuid())
  varianceId  String
  variance    MmCountVariance @relation(fields: [varianceId], references: [id], onDelete: Cascade)
  taskId      String
  task        MmCountTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason      String?
  status      String    @default("OPEN")
  requestedBy String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([varianceId])
  @@index([taskId, status])
  @@map("mm_count_recounts")
}

model MmCountAdjustmentRequest {
  id                 String   @id @default(cuid())
  requestNumber      String   @unique
  sessionId          String
  session            MmCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  warehouseId        String
  warehouse          Warehouse @relation(fields: [warehouseId], references: [id])
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | POSTED
  status             String   @default("DRAFT")
  submittedBy        String?
  approvedBy         String?
  rejectedBy         String?
  rejectionReason    String?
  legacyAdjustmentId String?  @unique
  legacyAdjustment   MmInventoryAdjustment? @relation(fields: [legacyAdjustmentId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lines              MmCountAdjustmentRequestLine[]

  @@index([sessionId])
  @@index([companyId, status])
  @@index([warehouseId, status])
  @@map("mm_count_adjustment_requests")
}

model MmCountAdjustmentRequestLine {
  id               String   @id @default(cuid())
  requestId        String
  request          MmCountAdjustmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  taskId           String
  task             MmCountTask @relation(fields: [taskId], references: [id])
  varianceId       String?
  variance         MmCountVariance? @relation(fields: [varianceId], references: [id])
  quantity         Decimal
  reasonCodeId     String?
  reasonCode       MmCountReasonCode? @relation(fields: [reasonCodeId], references: [id])
  rootCause        String?
  correctiveAction String?
  managerRemarks   String?
  createdAt        DateTime @default(now())

  @@index([requestId])
  @@index([taskId])
  @@map("mm_count_adjustment_request_lines")
}

// ΓöÇΓöÇΓöÇ Inventory Valuation (MM-12) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmMaterialValuation {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  materialId         String
  material           MmMaterial @relation(fields: [materialId], references: [id])
  /// Valuation area = warehouse
  warehouseId        String
  warehouse          Warehouse @relation(fields: [warehouseId], references: [id])
  currencyId         String?
  currency           MmCurrency? @relation(fields: [currencyId], references: [id])
  /// Optional profile code / display name (ValuationProfile bridge)
  code               String?
  name               String?
  isActive           Boolean   @default(true)
  /// STANDARD_COST | MOVING_AVERAGE | FIFO
  valuationMethod    String
  standardCost       Decimal   @default(0)
  movingAverageCost  Decimal   @default(0)
  effectiveDate      DateTime  @default(now())
  revision           Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, materialId, warehouseId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([valuationMethod])
  @@index([isActive])
  @@map("mm_material_valuation")
}

model MmCostLayer {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  materialId         String
  material           MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId        String
  warehouse          Warehouse @relation(fields: [warehouseId], references: [id])
  batchId            String?
  receiptTxnId       String
  receiptTxn         MmInventoryTransaction @relation(fields: [receiptTxnId], references: [id])
  receiptDocumentId  String?
  originalQuantity   Decimal
  remainingQuantity  Decimal
  unitCost           Decimal
  postingDate        DateTime
  /// OPEN | DEPLETED | REVERSED
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([materialId, warehouseId, postingDate])
  @@index([remainingQuantity])
  @@index([status])
  @@index([receiptTxnId])
  @@map("mm_cost_layer")
}

model MmInventoryValuationTransaction {
  id                 String    @id @default(cuid())
  valuationNumber    String    @unique
  inventoryTxnId     String    @unique
  inventoryTxn       MmInventoryTransaction @relation(fields: [inventoryTxnId], references: [id])
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  materialId         String
  material           MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId        String
  warehouse          Warehouse @relation(fields: [warehouseId], references: [id])
  /// STANDARD_COST | MOVING_AVERAGE | FIFO
  valuationMethod    String
  /// IN | OUT | REVERSAL
  direction          String
  quantity           Decimal
  unitCost           Decimal
  totalCost          Decimal
  priceVariance      Decimal   @default(0)
  movingAvgBefore    Decimal?
  movingAvgAfter     Decimal?
  /// FIFO: [{layerId, qty, unitCost}]
  layerConsumptions  Json?
  reversalOfId       String?   @unique
  reversalOf         MmInventoryValuationTransaction? @relation("ValTxnReversal", fields: [reversalOfId], references: [id])
  reversedBy         MmInventoryValuationTransaction? @relation("ValTxnReversal")
  createdAt          DateTime  @default(now())

  priceVariances     MmPriceVariance[]

  @@index([materialId])
  @@index([warehouseId])
  @@index([valuationMethod])
  @@index([companyId])
  @@map("mm_inventory_valuation_transaction")
}

model MmStandardCostRevision {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  materialId    String
  material      MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  standardCost  Decimal
  effectiveDate DateTime
  revision      Int
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([materialId, warehouseId])
  @@map("mm_standard_cost_revisions")
}

model MmLandedCost {
  id              String    @id @default(cuid())
  documentNumber  String    @unique
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  /// QUANTITY | WEIGHT | VOLUME | VALUE | MANUAL | CUSTOM
  allocationBase  String    @default("VALUE")
  currencyId      String?
  totalAmount     Decimal   @default(0)
  /// DRAFT | ALLOCATED | CANCELLED
  status          String    @default("DRAFT")
  referenceDocType String?
  referenceDocId  String?
  remarks         String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines           MmLandedCostLine[]
  allocations     MmLandedCostAllocation[]

  @@index([status])
  @@index([companyId])
  @@map("mm_landed_cost")
}

model MmLandedCostLine {
  id            String      @id @default(cuid())
  landedCostId  String
  landedCost    MmLandedCost @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  /// FREIGHT | CUSTOMS | INSURANCE | DUTY | HANDLING | OTHER
  costType      String
  costElementId String?
  costElement   MmCostElement? @relation(fields: [costElementId], references: [id])
  description   String?
  amount        Decimal
  materialId    String?
  material      MmMaterial? @relation(fields: [materialId], references: [id])
  weight        Decimal?
  volume        Decimal?
  quantity      Decimal?
  valueBase     Decimal?

  @@index([landedCostId])
  @@index([costElementId])
  @@map("mm_landed_cost_lines")
}

model MmLandedCostAllocation {
  id            String      @id @default(cuid())
  landedCostId  String
  landedCost    MmLandedCost @relation(fields: [landedCostId], references: [id], onDelete: Cascade)
  materialId    String
  material      MmMaterial  @relation(fields: [materialId], references: [id])
  allocatedAmount Decimal
  allocationShare Decimal?
  notes         String?

  @@index([landedCostId])
  @@index([materialId])
  @@map("mm_landed_cost_allocations")
}

/// Company-scoped landed / acquisition cost element master
model MmCostElement {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  /// FREIGHT | INSURANCE | CUSTOMS | DUTY | HANDLING | OTHER
  costType    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  landedCostLines MmLandedCostLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([costType])
  @@index([isActive])
  @@map("mm_cost_elements")
}

/// Auditable price variance document (does not duplicate the inventory ledger)
model MmPriceVariance {
  id               String   @id @default(cuid())
  varianceNumber   String   @unique
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  materialId       String
  material         MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  valuationTxnId   String?
  valuationTxn     MmInventoryValuationTransaction? @relation(fields: [valuationTxnId], references: [id])
  inventoryTxnId   String?
  /// PPV | IPV | LANDED | REVALUATION
  varianceType     String
  poPrice          Decimal?
  standardCost     Decimal?
  invoicePrice     Decimal?
  landedUnitCost   Decimal?
  actualUnitCost   Decimal?
  varianceAmount   Decimal  @default(0)
  /// OPEN | POSTED | REVERSED
  status           String   @default("POSTED")
  remarks          String?
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([valuationTxnId])
  @@index([varianceType])
  @@index([status])
  @@map("mm_price_variances")
}

// ΓöÇΓöÇΓöÇ Three-Way Match (MM-13) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmSupplierInvoice {
  id               String    @id @default(cuid())
  invoiceNumber    String    @unique
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  supplierId       String
  supplier         MmSupplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId  String
  purchaseOrder    MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  currencyId       String?
  currency         MmCurrency? @relation("InvoiceCurrency", fields: [currencyId], references: [id])
  invoiceDate      DateTime
  postingDate      DateTime?
  taxAmount        Decimal   @default(0)
  totalAmount      Decimal   @default(0)
  /// DRAFT | SUBMITTED | MATCHED | PARTIALLY_MATCHED | VARIANCE | BLOCKED | CANCELLED
  status           String    @default("DRAFT")
  /// Last engine result (same vocabulary as status match outcomes)
  matchStatus      String?
  paymentEligible  Boolean   @default(false)
  invoicedApplied  Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  matchedAt        DateTime?
  createdBy        String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines            MmSupplierInvoiceLine[]
  exceptions       MmMatchException[]

  @@index([status])
  @@index([companyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("mm_supplier_invoices")
}

model MmSupplierInvoiceLine {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             MmSupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber          Int      @default(1)
  materialId          String
  material            MmMaterial @relation(fields: [materialId], references: [id])
  purchaseOrderLineId String
  purchaseOrderLine   MmPurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  uomId               String
  uom                 MmUom @relation("InvoiceLineUom", fields: [uomId], references: [id])
  invoicedQuantity    Decimal
  unitPrice           Decimal  @default(0)
  taxAmount           Decimal  @default(0)
  lineTotal           Decimal  @default(0)
  matchedQuantity     Decimal  @default(0)
  /// PENDING | MATCHED | PARTIALLY_MATCHED | VARIANCE | BLOCKED
  matchStatus         String   @default("PENDING")
  quantityVariance    Decimal  @default(0)
  priceVariance       Decimal  @default(0)
  taxVariance         Decimal  @default(0)
  remarks             String?

  receipts            MmSupplierInvoiceLineReceipt[]
  exceptions          MmMatchException[]

  @@index([invoiceId])
  @@index([purchaseOrderLineId])
  @@index([materialId])
  @@map("mm_supplier_invoice_lines")
}

model MmSupplierInvoiceLineReceipt {
  id                 String   @id @default(cuid())
  invoiceLineId      String
  invoiceLine        MmSupplierInvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  goodsReceiptLineId String
  goodsReceiptLine   MmGoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id])
  allocatedQuantity  Decimal

  @@unique([invoiceLineId, goodsReceiptLineId])
  @@index([goodsReceiptLineId])
  @@map("mm_supplier_invoice_line_receipts")
}

model MmMatchException {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          MmSupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLineId    String?
  invoiceLine      MmSupplierInvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  purchaseOrderId  String
  purchaseOrder    MmPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  /// QUANTITY | PRICE | TAX | CURRENCY | SUPPLIER | MATERIAL
  varianceType     String
  /// VARIANCE | BLOCKED
  severity         String
  message          String
  poSnapshot       Json?
  grSnapshot       Json?
  invoiceSnapshot  Json?
  /// OPEN | ACKNOWLEDGED | RESOLVED | WAIVED
  status           String   @default("OPEN")
  paymentBlocked   Boolean  @default(true)
  notifiedAt       DateTime?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([varianceType])
  @@index([purchaseOrderId])
  @@map("mm_match_exceptions")
}

// ΓöÇΓöÇΓöÇ Planning / MRP (MM-14) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ─── Planning / MRP (MM-05 / Phase 10 Advanced MRP) ─────────────────────────
// MRP produces planning output only. It MUST NOT post inventory.

model MmMrpRun {
  id                   String    @id @default(cuid())
  runNumber            String    @unique
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id])
  plantId              String?
  plant                Plant?    @relation(fields: [plantId], references: [id])
  warehouseId          String?
  warehouse            Warehouse? @relation(fields: [warehouseId], references: [id])
  /// Legacy field; prefer startedAt / completedAt
  executionTime        DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  planningHorizonDays  Int       @default(30)
  includeOpenReceipts  Boolean   @default(true)
  autoCreatePurchaseRequisitions Boolean @default(false)
  /// Snapshot of run parameters (horizon, scopes, flags)
  parametersJson       Json?
  resultsCount         Int       @default(0)
  /// QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED (PENDING accepted as QUEUED alias)
  status               String    @default("QUEUED")
  createdBy            String?
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  requirements         MmMaterialRequirement[]
  suggestions          MmProcurementSuggestion[]
  plannedOrders        MmPlannedOrder[]
  supplyProposals      MmSupplyProposal[]
  purchaseRequisitions MmPurchaseRequisition[] @relation("PrSourceMrpRun")

  @@index([companyId])
  @@index([plantId])
  @@index([status])
  @@map("mm_mrp_run")
}

/// MRPRequirement bridge — snapshot row per material/warehouse for a run
model MmMaterialRequirement {
  id                     String    @id @default(cuid())
  mrpRunId               String
  mrpRun                 MmMrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  materialId             String
  material               MmMaterial @relation(fields: [materialId], references: [id])
  unrestrictedQty        Decimal   @default(0)
  reservedQty            Decimal   @default(0)
  qualityQty             Decimal   @default(0)
  blockedQty             Decimal   @default(0)
  availableQty           Decimal   @default(0)
  incomingQty            Decimal   @default(0)
  plannedSupplyQty       Decimal   @default(0)
  productionSupplyQty    Decimal   @default(0)
  demandQty              Decimal   @default(0)
  grossDemand            Decimal   @default(0)
  projectedAvailable     Decimal   @default(0)
  safetyStock            Decimal   @default(0)
  reorderPoint           Decimal   @default(0)
  moq                    Decimal   @default(0)
  lotSize                Decimal   @default(0)
  minStock               Decimal   @default(0)
  maxStock               Decimal   @default(0)
  leadTimeDays           Int       @default(0)
  netRequirement         Decimal   @default(0)
  recommendedQty         Decimal   @default(0)
  shortageQty            Decimal   @default(0)
  /// CREATE_PR | CREATE_PLANNED_PRODUCTION | MONITOR | NONE
  recommendedAction      String?
  procurementType        String?
  planningStrategy       String?
  requiredDate           DateTime?
  /// Aggregated demand source: SALES | PRODUCTION | ... | MIXED | REORDER
  source                 String?
  expectedProcurementDate DateTime?
  projectedStockoutDate  DateTime?
  belowReorderPoint      Boolean   @default(false)
  shortage               Boolean   @default(false)
  createdAt              DateTime  @default(now())

  suggestions            MmProcurementSuggestion[]
  plannedOrders          MmPlannedOrder[]

  @@unique([mrpRunId, warehouseId, materialId])
  @@index([mrpRunId])
  @@index([materialId])
  @@index([belowReorderPoint])
  @@index([shortage])
  @@map("mm_material_requirement")
}

/// PlanningParameter bridge — warehouse/company planning params for a material
model MmReorderRule {
  id                    String    @id @default(cuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  materialId            String
  material              MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId           String?
  warehouse             Warehouse? @relation(fields: [warehouseId], references: [id])
  reorderPoint          Decimal   @default(0)
  safetyStock           Decimal   @default(0)
  reorderQuantity       Decimal   @default(0)
  minimumOrderQuantity  Decimal   @default(0)
  minStock              Decimal   @default(0)
  maxStock              Decimal   @default(0)
  /// Prefer over reorderQuantity when > 0 for lot rounding
  lotSize               Decimal   @default(0)
  leadTimeDays          Int       @default(0)
  reviewPeriodDays      Int       @default(0)
  /// REORDER_POINT | TIME_PHASED | MIN_MAX
  planningStrategy      String    @default("REORDER_POINT")
  /// BUY | MAKE | BOTH
  procurementType       String    @default("BUY")
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, materialId])
  @@index([warehouseId])
  @@map("mm_reorder_rule")
}

model MmPlanningDemand {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  plantId           String?
  plant             Plant?    @relation(fields: [plantId], references: [id])
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  materialId        String
  material          MmMaterial @relation(fields: [materialId], references: [id])
  demandDate        DateTime
  quantity          Decimal
  /// SALES | PRODUCTION | MAINTENANCE | PROJECTS | MANUAL_INTERNAL | FORECAST
  sourceType        String    @default("MANUAL_INTERNAL")
  sourceDocumentId  String?
  /// OPEN | CANCELLED
  status            String    @default("OPEN")
  remarks           String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, materialId])
  @@index([demandDate])
  @@index([warehouseId])
  @@index([plantId])
  @@index([status])
  @@map("mm_planning_demands")
}

model MmProcurementSuggestion {
  id                     String    @id @default(cuid())
  mrpRunId               String
  mrpRun                 MmMrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  materialRequirementId  String?
  materialRequirement    MmMaterialRequirement? @relation(fields: [materialRequirementId], references: [id])
  plannedOrderId         String?
  plannedOrder           MmPlannedOrder? @relation(fields: [plannedOrderId], references: [id])
  /// PR_RECOMMENDATION | PLANNED_REPLENISHMENT
  suggestionType         String
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  materialId             String
  material               MmMaterial @relation(fields: [materialId], references: [id])
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  quantity               Decimal
  uomId                  String
  requiredDate           DateTime
  leadTimeDays           Int       @default(0)
  preferredSupplierId    String?
  preferredSupplier      MmSupplier? @relation("SuggestionPreferredSupplier", fields: [preferredSupplierId], references: [id])
  /// SHORTAGE | BELOW_REORDER_POINT | NET_REQUIREMENT
  reason                 String?
  demandSource           String?
  shortageReason         String?
  moq                    Decimal   @default(0)
  lotSize                Decimal   @default(0)
  explanation            String?
  /// OPEN | CONVERTED | DISMISSED
  status                 String    @default("OPEN")
  purchaseRequisitionId  String?
  purchaseRequisition    MmPurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([mrpRunId])
  @@index([status])
  @@index([materialId])
  @@index([preferredSupplierId])
  @@map("mm_procurement_suggestions")
}

/// PlannedPurchaseOrder → PR; PlannedProduction → Production Requirement (future)
model MmPlannedOrder {
  id                     String    @id @default(cuid())
  plannedOrderNumber     String    @unique
  mrpRunId               String
  mrpRun                 MmMrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  materialRequirementId  String?
  materialRequirement    MmMaterialRequirement? @relation(fields: [materialRequirementId], references: [id])
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  plantId                String?
  plant                  Plant?    @relation(fields: [plantId], references: [id])
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  materialId             String
  material               MmMaterial @relation(fields: [materialId], references: [id])
  /// PLANNED_PURCHASE | PLANNED_PRODUCTION
  orderType              String
  quantity               Decimal
  uomId                  String
  uom                    MmUom     @relation("PlannedOrderUom", fields: [uomId], references: [id])
  requiredDate           DateTime
  startDate              DateTime?
  procurementType        String    @default("BUY")
  /// OPEN | CONVERTED | CANCELLED | FIRM
  status                 String    @default("OPEN")
  purchaseRequisitionId  String?
  purchaseRequisition    MmPurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id])
  sourceDemandIds        String?
  remarks                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  suggestions            MmProcurementSuggestion[]
  supplyProposals        MmSupplyProposal[]

  @@index([mrpRunId])
  @@index([companyId])
  @@index([warehouseId])
  @@index([materialId])
  @@index([status])
  @@index([orderType])
  @@map("mm_planned_orders")
}

model MmSupplyProposal {
  id                 String    @id @default(cuid())
  proposalNumber     String    @unique
  mrpRunId           String
  mrpRun             MmMrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  plannedOrderId     String?
  plannedOrder       MmPlannedOrder? @relation(fields: [plannedOrderId], references: [id])
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  warehouseId        String
  warehouse          Warehouse @relation(fields: [warehouseId], references: [id])
  materialId         String
  material           MmMaterial @relation(fields: [materialId], references: [id])
  /// OPEN_PO | EXPECTED_RECEIPT | PLANNED_ORDER | PRODUCTION
  supplyType         String
  quantity           Decimal
  availableDate      DateTime
  sourceDocumentType String?
  sourceDocumentId   String?
  /// OPEN | CONSUMED | CANCELLED
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([mrpRunId])
  @@index([companyId, warehouseId, materialId])
  @@index([status])
  @@map("mm_supply_proposals")
}

model MmSupplierScoreWeightConfig {
  id                String   @id @default(cuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id])
  deliveryWeight    Int      @default(25)
  qualityWeight     Int      @default(25)
  priceWeight       Int      @default(20)
  quantityWeight    Int      @default(15)
  serviceWeight     Int      @default(10)
  complianceWeight  Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("mm_supplier_score_weight_config")
}

model MmSupplierAlertConfig {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  company                    Company  @relation(fields: [companyId], references: [id])
  scoreThreshold             Decimal  @default(70)
  lateDeliveryRateThreshold  Decimal  @default(0.25)
  rejectionRateThreshold     Decimal  @default(0.10)
  shortageRateThreshold      Decimal  @default(0.15)
  priceVarianceThreshold     Decimal  @default(0.10)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("mm_supplier_alert_config")
}

model MmSupplierEvaluation {
  id                      String   @id @default(cuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id])
  supplierId              String
  supplier                MmSupplier @relation(fields: [supplierId], references: [id])
  periodStart             DateTime
  periodEnd               DateTime
  onTimePct               Decimal  @default(0)
  lateDeliveryRate        Decimal  @default(0)
  avgDelayDays            Decimal  @default(0)
  qualityAcceptanceRate   Decimal  @default(0)
  rejectionRate           Decimal  @default(0)
  returnRate              Decimal  @default(0)
  leadTimeAccuracyPct     Decimal  @default(0)
  priceVariancePct        Decimal  @default(0)
  landedCostVariancePct   Decimal  @default(0)
  fillRate                Decimal  @default(0)
  shortageRate            Decimal  @default(0)
  overDeliveryRate        Decimal  @default(0)
  avgResponseHours        Decimal  @default(0)
  complianceRate          Decimal  @default(0)
  purchaseVolume          Decimal  @default(0)
  deliveryScore           Decimal  @default(0)
  qualityScore            Decimal  @default(0)
  priceScore              Decimal  @default(0)
  quantityScore           Decimal  @default(0)
  serviceScore            Decimal  @default(0)
  complianceScore         Decimal  @default(0)
  overallScore            Decimal  @default(0)
  deliveryWeight          Int      @default(25)
  qualityWeight           Int      @default(25)
  priceWeight             Int      @default(20)
  quantityWeight          Int      @default(15)
  serviceWeight           Int      @default(10)
  complianceWeight        Int      @default(5)
  sampleSizes             Json?
  computedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  alerts                  MmSupplierAlert[]

  @@unique([companyId, supplierId, periodStart, periodEnd])
  @@index([companyId])
  @@index([supplierId])
  @@index([overallScore])
  @@index([periodStart, periodEnd])
  @@map("mm_supplier_evaluation")
}

model MmSupplierAlert {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  supplierId    String
  supplier      MmSupplier @relation(fields: [supplierId], references: [id])
  evaluationId  String
  evaluation    MmSupplierEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  /// POOR_SCORE | LATE_DELIVERY | HIGH_REJECTION | REPEATED_SHORTAGE | HIGH_PRICE_VARIANCE
  alertType     String   @default("POOR_SCORE")
  score         Decimal
  threshold     Decimal
  /// OPEN | ACKNOWLEDGED | DISMISSED
  status        String   @default("OPEN")
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@index([evaluationId])
  @@index([alertType])
  @@map("mm_supplier_alerts")
}

/// Controlled manual assessment ΓÇö never overwrites MmSupplierEvaluation computed scores.
model MmSupplierManualAssessment {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  supplierId        String
  supplier          MmSupplier @relation(fields: [supplierId], references: [id])
  assessmentDate    DateTime @default(now())
  periodStart       DateTime?
  periodEnd         DateTime?
  deliveryScore     Decimal?
  qualityScore      Decimal?
  priceScore        Decimal?
  serviceScore      Decimal?
  complianceScore   Decimal?
  overallScore      Decimal
  notes             String?
  assessedBy        String
  /// DRAFT | SUBMITTED | APPROVED | CANCELLED
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@index([assessmentDate])
  @@map("mm_supplier_manual_assessments")
}

// ΓöÇΓöÇΓöÇ Returns & Disposal (MM-16) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmReturnsDisposalConfig {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  company                    Company  @relation(fields: [companyId], references: [id])
  approvalAmountThreshold    Decimal  @default(10000)
  approvalQuantityThreshold  Decimal  @default(0)
  /// When true, ExpiryControlService auto-blocks past-expiry UNRESTRICTED stock
  autoBlockExpired           Boolean  @default(false)
  /// Target stock status for auto-block (default EXPIRED)
  expiredBlockStockStatus    String   @default("EXPIRED")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("mm_returns_disposal_config")
}

model MmSupplierReturn {
  id                String    @id @default(cuid())
  returnNumber      String    @unique
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  supplierId        String
  supplier          MmSupplier @relation(fields: [supplierId], references: [id])
