  /// PENDING | POSTED | LINKED_DISPOSAL
  dispositionStatus   String   @default("PENDING")
  inventoryTxnId      String?
  disposalId          String?
  remarks             String?

  @@index([returnId])
  @@index([materialId])
  @@map("mm_customer_return_lines")
}

model MmCustomerReturnAudit {
  id            String   @id @default(cuid())
  returnId      String
  customerReturn MmCustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  action        String
  field         String?
  oldValue      String?
  newValue      String?
  performedBy   String?
  details       Json?
  performedAt   DateTime @default(now())

  @@index([returnId])
  @@map("mm_customer_return_audits")
}

/// Canonical intake header (1:1 with legacy MmCustomerReturn)
model MmCustomerReturnIntake {
  id                     String   @id @default(cuid())
  legacyCustomerReturnId String   @unique
  customerReturn         MmCustomerReturn @relation(fields: [legacyCustomerReturnId], references: [id], onDelete: Cascade)
  companyId              String
  warehouseId            String
  receivedAt             DateTime @default(now())
  receivedBy             String?
  carrierRef             String?
  packageCount           Int?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
  @@index([warehouseId])
  @@map("mm_customer_return_intakes")
}

model MmReturnInspection {
  id                     String   @id @default(cuid())
  legacyCustomerReturnId String
  customerReturn         MmCustomerReturn @relation(fields: [legacyCustomerReturnId], references: [id], onDelete: Cascade)
  inspectedAt            DateTime @default(now())
  inspectedBy            String?
  /// PASS | FAIL | CONDITIONAL
  result                 String?
  lotNotes               String?
  decisionNotes          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([legacyCustomerReturnId])
  @@map("mm_return_inspections")
}

model MmReturnDisposition {
  id                     String   @id @default(cuid())
  legacyCustomerReturnId String
  customerReturn         MmCustomerReturn @relation(fields: [legacyCustomerReturnId], references: [id], onDelete: Cascade)
  customerReturnLineId   String?
  lineNumber             Int      @default(1)
  materialId             String
  quantity               Decimal
  uomId                  String
  batchId                String?
  serialNumberId         String?
  /// RESTOCK | REPAIR | BLOCK | SCRAP
  disposition            String
  stockStatus            String?
  scrapTransactionId     String?
  disposalId             String?
  inventoryTxnId         String?
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([legacyCustomerReturnId])
  @@index([customerReturnLineId])
  @@index([materialId])
  @@map("mm_return_dispositions")
}

/// Thin posting document 1:1 with posted disposal (SCRAP type / disposition SCRAP)
model MmScrapTransaction {
  id               String    @id @default(cuid())
  scrapNumber      String    @unique
  companyId        String
  warehouseId      String
  legacyDisposalId String    @unique
  disposal         MmDisposal @relation(fields: [legacyDisposalId], references: [id], onDelete: Cascade)
  postedAt         DateTime  @default(now())
  postedBy         String?
  idempotencyKey   String?   @unique
  inventoryTxnIds  Json?
  createdAt        DateTime  @default(now())

  @@index([companyId])
  @@index([warehouseId])
  @@map("mm_scrap_transactions")
}

// ─── Scanner / Mobile Ops (MM-12 / Phase 11) ─────────────────────────────────
// Scanner → BarcodeResolve → Domain Workflow → InventoryPostingService (only when stock changes)
// Scanner MUST NOT update balances or create ledger rows directly.

model MmMobileDevice {
  id               String    @id @default(cuid())
  deviceCode       String    @unique
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  name             String?
  /// WEB | ANDROID | IOS | HANDHELD | RFID
  platform         String    @default("WEB")
  /// ACTIVE | REVOKED | DISABLED
  status           String    @default("ACTIVE")
  sessionToken     String?
  sessionExpiresAt DateTime?
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scannerEvents    MmScannerEvent[]
  syncQueue        MmMobileSyncQueue[]

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([sessionToken])
  @@map("mm_mobile_devices")
}

/// ScanEvent bridge — immutable audit of every mobile/scanner submission
model MmScannerEvent {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique
  deviceId         String
  mobileDeviceId   String?
  mobileDevice     MmMobileDevice? @relation(fields: [mobileDeviceId], references: [id])
  userId           String
  operation        String
  barcode          String
  timestamp        DateTime
  clientTimestamp  DateTime?
  quantity         Decimal?
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  storageBinId     String?
  materialId       String?
  batchId          String?
  serialNumberId   String?
  documentType     String?
  documentId       String?
  /// SUCCESS | FAILED | DUPLICATE | CONFLICT | REJECTED
  status           String
  errorCode        String?
  conflictCode     String?
  errorMessage     String?
  offlineQueued    Boolean   @default(false)
  syncQueueId      String?
  result           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([operation])
  @@index([status])
  @@index([createdAt])
  @@index([mobileDeviceId])
  @@index([conflictCode])
  @@map("mm_scanner_events")
}

/// Offline foundation — local queue replay validated server-side (never blind overwrite)
model MmMobileSyncQueue {
  id               String    @id @default(cuid())
  deviceId         String
  mobileDeviceId   String?
  mobileDevice     MmMobileDevice? @relation(fields: [mobileDeviceId], references: [id])
  idempotencyKey   String    @unique
  operation        String
  payload          Json
  clientTimestamp  DateTime
  /// PENDING | SYNCING | ACCEPTED | REJECTED | CONFLICT
  status           String    @default("PENDING")
  conflictCode     String?
  errorMessage     String?
  serverEventId    String?
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  syncedAt         DateTime?

  @@index([deviceId, status])
  @@index([mobileDeviceId])
  @@index([status])
  @@map("mm_mobile_sync_queue")
}

model MmDashboardAnalyticsCache {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  cacheKey    String   @unique
    /// AGING | TURNOVER | DEAD_STOCK | MOVEMENT | PROCUREMENT_SPEND | FULL_DASHBOARD | SUPPLIERS
    /// | INVENTORY | PROCUREMENT | WAREHOUSE | QUALITY | VALUATION | EXPIRY | AVAILABILITY
    metricType  String
  payload     Json
  computedAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([companyId])
  @@index([expiresAt])
  @@index([metricType])
  @@map("mm_dashboard_analytics_cache")
}

// ─── SCM Transportation ───────────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum VehicleType {
  TRUCK
  VAN
  TRAILER
  REEFER
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  INACTIVE
}

enum TripStatus {
  DRAFT
  PLANNED
  /// Vehicle (+ optional driver) assigned ΓÇö ready to start (Phase 3.2 Dispatch)
  ASSIGNED
  /// Trip started ΓÇö live tracking (Phase 3.3). Maps to diagram IN_TRANSIT.
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
  FAILED
}

enum ShipmentStatus {
  DRAFT
  READY
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// Outbound shipping vs customer/supplier pickup (return to hub).
enum ShipmentMovementType {
  DELIVERY
  PICKUP
}

enum MaintenanceType {
  PREVENTATIVE
  CORRECTIVE
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Vehicle {
  id                 String               @id @default(cuid())
  code               String               @unique
  plateNumber        String               @unique
  make               String
  model              String
  year               Int?
  type               VehicleType
  status             VehicleStatus        @default(AVAILABLE)
  capacityWeightKg   Float                @default(0)
  capacityVolumeM3   Float                @default(0)
  /// Max items this vehicle can carry (primary load constraint)
  capacityQty        Int                  @default(0)
  /// Last recorded odometer (km). Updated live from GPS while moving; finalized on trip complete.
  odometerKm         Float                @default(0)
  /// Service due when odometerKm >= this value (e.g. 50000). Flags preventative maintenance.
  maintenanceThresholdKm Float?
  routingBlocked     Boolean              @default(false)
  /// flespi JT808 ident = first 14 digits of IMEI (or full IMEI). See docs/SCM_FLESPI_VL502.md
  telematicsDeviceId String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  trips              Trip[]
  gpsLogs            GpsLog[]
  maintenanceRecords MaintenanceRecord[]

  @@index([status])
  @@index([type])
  @@index([telematicsDeviceId])
}

model Driver {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode  String?      @unique
  firstName     String
  lastName      String
  licenseNumber String       @unique
  licenseExpiry DateTime
  phone         String
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  trips         Trip[]

  @@index([status])
}

model Shipment {
  id                  String             @id @default(cuid())
  reference           String             @unique
  customerName        String?
  originAddress       String?
  originLat           Float?
  originLng           Float?
  destAddress         String
  destLat             Float?
  destLng             Float?
  weightKg            Float              @default(0)
  volumeM3            Float              @default(0)
  /// Item count ΓÇö primary load field for vehicle capacity
  quantity            Int                @default(0)
  /// Optional material / SKU reference (MM master stays in MM)
  materialCode        String?
  /// External MM / WMS order id ΓÇö warehouse release stub hand-off key
  externalOrderId     String?
  /// Short cargo description for drivers / load lists
  description         String?
  isFragile           Boolean            @default(false)
  requiresColdChain   Boolean            @default(false)
  /// DELIVERY = ship to customer; PICKUP = collect from customer/supplier
  movementType        ShipmentMovementType @default(DELIVERY)
  status              ShipmentStatus     @default(DRAFT)
  requestedPickupAt   DateTime?
  requestedDeliveryAt DateTime?
  earliestDeliveryAt  DateTime?
  latestDeliveryAt    DateTime?
  podSignatureUrl     String?
  podPhotoUrl         String?
  deliveredAt         DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tripStopShipments   TripStopShipment[]

  @@index([status])
  @@index([movementType])
}

model Trip {
  id             String     @id @default(cuid())
  code           String     @unique
  vehicleId      String?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status         TripStatus @default(DRAFT)
  plannedStartAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalWeightKg  Float?
  totalVolumeM3  Float?
  totalQty       Int?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  stops          TripStop[]
  gpsLogs        GpsLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
}

model TripStop {
  id         String             @id @default(cuid())
  tripId     String
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence   Int
  name       String?
  address    String
  lat        Float?
  lng        Float?
  windowStart DateTime?
  windowEnd  DateTime?
  status     StopStatus         @default(PENDING)
  arrivedAt  DateTime?
  completedAt DateTime?
  notes      String?
  /// Driver POD ΓÇö signature image (data URL or hosted URL)
  podSignatureUrl String?
  /// Driver POD ΓÇö proof photo
  podPhotoUrl     String?
  /// Driver POD notes
  podNotes        String?
  /// Set when status = FAILED
  failureReason   String?
  /// Optional map pin color for intermediate stops (hex, e.g. #f59e0b). Destination always uses red.
  pinColor   String?
  shipments  TripStopShipment[]

  @@unique([tripId, sequence])
  @@index([tripId])
}

model TripStopShipment {
  id         String   @id @default(cuid())
  tripStopId String
  tripStop   TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// PICKUP | DROPOFF
  action     String

  @@unique([tripStopId, shipmentId, action])
  @@index([shipmentId])
}

model GpsLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  latitude   Float
  longitude  Float
  speedKmh   Float    @default(0)
  heading    Float?
  /// Optional sparse device payload (e.g. fuelPct, rpm) ΓÇö not a full OBD dump
  rawPayload Json?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
}

model MaintenanceRecord {
  id            String            @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          MaintenanceType
  status        MaintenanceStatus @default(SCHEDULED)
  title         String
  description   String?
  odometerKm    Float?
  cost          Float?
  scheduledAt   DateTime
  completedAt   DateTime?
  /// When true (and status not COMPLETED/CANCELLED), vehicle.routingBlocked is set
  blocksRouting Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([vehicleId, status])
  @@index([scheduledAt])
}

enum GeofenceKind {
  HUB
  CHECKPOINT
  ZONE
}

enum GeofenceDetect {
  ENTER
  EXIT
  INSIDE
  OUTSIDE
}

/// Circular geofence / hub ΓÇö Postgres is CRUD source of truth; Tile38 holds live geometry + hooks
model Geofence {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  kind      GeofenceKind @default(HUB)
  lat       Float
  lng       Float
  radiusM   Int
  color     String?
  active    Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  events    GeofenceEvent[]

  @@index([active])
  @@index([kind])
}

model GeofenceEvent {
  id         String         @id @default(cuid())
  geofenceId String
  geofence   Geofence       @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicleId  String
  detect     GeofenceDetect
  latitude   Float
  longitude  Float
  rawPayload Json?
  detectedAt DateTime       @default(now())

  @@index([geofenceId, detectedAt])
  @@index([vehicleId, detectedAt])
}

enum PlanningBucketSize {
  DAY
  WEEK
}

/// Singleton planning-horizon parameters for Demand Planning (Phase 1).
model ScmPlanningSettings {
  id             String             @id @default("default")
  horizonWeeks   Int                @default(12)
  bucketSize     PlanningBucketSize @default(WEEK)
  frozenZoneDays Int                @default(7)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

/// Kept for future Demand Planning ΓÇö no API/UI yet
model DemandForecast {
  id           String   @id @default(cuid())
  productCode  String
  locationCode String
  periodStart  DateTime
  periodEnd    DateTime
  quantity     Float
  unit         String   @default("EA")
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productCode, locationCode, periodStart])
}
