generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  userName      String         @unique
  passwordHash  String
  role          String
  avatar        String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  driver        Driver?
}

model Notification {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target        String
  description   String
  type          Int      @default(0)
  image         String   @default("")
  location      String   @default("")
  locationLabel String   @default("")
  status        String   @default("")
  readed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([readed, createdAt])
}

// ─── SCM Transportation ─────────────────────────────────────────────────────

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum VehicleType {
  TRUCK
  VAN
  TRAILER
  REEFER
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  INACTIVE
}

enum TripStatus {
  DRAFT
  PLANNED
  /// Vehicle (+ optional driver) assigned — ready to start (Phase 3.2 Dispatch)
  ASSIGNED
  /// Trip started — live tracking (Phase 3.3). Maps to diagram IN_TRANSIT.
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
  FAILED
}

enum ShipmentStatus {
  DRAFT
  READY
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// Outbound shipping vs customer/supplier pickup (return to hub).
enum ShipmentMovementType {
  DELIVERY
  PICKUP
}

enum MaintenanceType {
  PREVENTATIVE
  CORRECTIVE
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Vehicle {
  id                 String               @id @default(cuid())
  code               String               @unique
  plateNumber        String               @unique
  make               String
  model              String
  year               Int?
  type               VehicleType
  status             VehicleStatus        @default(AVAILABLE)
  capacityWeightKg   Float                @default(0)
  capacityVolumeM3   Float                @default(0)
  /// Max items this vehicle can carry (primary load constraint)
  capacityQty        Int                  @default(0)
  /// Last recorded odometer (km). Updated live from GPS while moving; finalized on trip complete.
  odometerKm         Float                @default(0)
  /// Service due when odometerKm >= this value (e.g. 50000). Flags preventative maintenance.
  maintenanceThresholdKm Float?
  routingBlocked     Boolean              @default(false)
  /// flespi JT808 ident = first 14 digits of IMEI (or full IMEI). See docs/SCM_FLESPI_VL502.md
  telematicsDeviceId String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  trips              Trip[]
  gpsLogs            GpsLog[]
  maintenanceRecords MaintenanceRecord[]

  @@index([status])
  @@index([type])
  @@index([telematicsDeviceId])
}

model Driver {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode  String?      @unique
  firstName     String
  lastName      String
  licenseNumber String       @unique
  licenseExpiry DateTime
  phone         String
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  trips         Trip[]

  @@index([status])
}

model Shipment {
  id                  String             @id @default(cuid())
  reference           String             @unique
  customerName        String?
  originAddress       String?
  originLat           Float?
  originLng           Float?
  destAddress         String
  destLat             Float?
  destLng             Float?
  weightKg            Float              @default(0)
  volumeM3            Float              @default(0)
  /// Item count — primary load field for vehicle capacity
  quantity            Int                @default(0)
  /// Optional material / SKU reference (MM master stays in MM)
  materialCode        String?
  /// External MM / WMS order id — warehouse release stub hand-off key
  externalOrderId     String?
  /// Short cargo description for drivers / load lists
  description         String?
  isFragile           Boolean            @default(false)
  requiresColdChain   Boolean            @default(false)
  /// DELIVERY = ship to customer; PICKUP = collect from customer/supplier
  movementType        ShipmentMovementType @default(DELIVERY)
  status              ShipmentStatus     @default(DRAFT)
  requestedPickupAt   DateTime?
  requestedDeliveryAt DateTime?
  earliestDeliveryAt  DateTime?
  latestDeliveryAt    DateTime?
  podSignatureUrl     String?
  podPhotoUrl         String?
  deliveredAt         DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tripStopShipments   TripStopShipment[]

  @@index([status])
  @@index([movementType])
}

model Trip {
  id             String     @id @default(cuid())
  code           String     @unique
  vehicleId      String?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status         TripStatus @default(DRAFT)
  plannedStartAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalWeightKg  Float?
  totalVolumeM3  Float?
  totalQty       Int?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  stops          TripStop[]
  gpsLogs        GpsLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
}

model TripStop {
  id         String             @id @default(cuid())
  tripId     String
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence   Int
  name       String?
  address    String
  lat        Float?
  lng        Float?
  windowStart DateTime?
  windowEnd  DateTime?
  status     StopStatus         @default(PENDING)
  arrivedAt  DateTime?
  completedAt DateTime?
  notes      String?
  /// Driver POD — signature image (data URL or hosted URL)
  podSignatureUrl String?
  /// Driver POD — proof photo
  podPhotoUrl     String?
  /// Driver POD notes
  podNotes        String?
  /// Set when status = FAILED
  failureReason   String?
  /// Optional map pin color for intermediate stops (hex, e.g. #f59e0b). Destination always uses red.
  pinColor   String?
  shipments  TripStopShipment[]

  @@unique([tripId, sequence])
  @@index([tripId])
}

model TripStopShipment {
  id         String   @id @default(cuid())
  tripStopId String
  tripStop   TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// PICKUP | DROPOFF
  action     String

  @@unique([tripStopId, shipmentId, action])
  @@index([shipmentId])
}

model GpsLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  latitude   Float
  longitude  Float
  speedKmh   Float    @default(0)
  heading    Float?
  /// Optional sparse device payload (e.g. fuelPct, rpm) — not a full OBD dump
  rawPayload Json?
  recordedAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([tripId, recordedAt])
}

model MaintenanceRecord {
  id            String            @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          MaintenanceType
  status        MaintenanceStatus @default(SCHEDULED)
  title         String
  description   String?
  odometerKm    Float?
  cost          Float?
  scheduledAt   DateTime
  completedAt   DateTime?
  /// When true (and status not COMPLETED/CANCELLED), vehicle.routingBlocked is set
  blocksRouting Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([vehicleId, status])
  @@index([scheduledAt])
}

enum GeofenceKind {
  HUB
  CHECKPOINT
  ZONE
}

enum GeofenceDetect {
  ENTER
  EXIT
  INSIDE
  OUTSIDE
}

/// Circular geofence / hub — Postgres is CRUD source of truth; Tile38 holds live geometry + hooks
model Geofence {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  kind      GeofenceKind @default(HUB)
  lat       Float
  lng       Float
  radiusM   Int
  color     String?
  active    Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  events    GeofenceEvent[]

  @@index([active])
  @@index([kind])
}

model GeofenceEvent {
  id         String         @id @default(cuid())
  geofenceId String
  geofence   Geofence       @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicleId  String
  detect     GeofenceDetect
  latitude   Float
  longitude  Float
  rawPayload Json?
  detectedAt DateTime       @default(now())

  @@index([geofenceId, detectedAt])
  @@index([vehicleId, detectedAt])
}

enum PlanningBucketSize {
  DAY
  WEEK
}

/// Singleton planning-horizon parameters for Demand Planning (Phase 1).
model ScmPlanningSettings {
  id             String             @id @default("default")
  horizonWeeks   Int                @default(12)
  bucketSize     PlanningBucketSize @default(WEEK)
  frozenZoneDays Int                @default(7)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

/// Kept for future Demand Planning — no API/UI yet
model DemandForecast {
  id           String   @id @default(cuid())
  productCode  String
  locationCode String
  periodStart  DateTime
  periodEnd    DateTime
  quantity     Float
  unit         String   @default("EA")
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productCode, locationCode, periodStart])
}
