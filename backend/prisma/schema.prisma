generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ΓöÇΓöÇΓöÇ Existing models ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  userName      String         @unique
  passwordHash  String
  role          String
  avatar        String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  driver        Driver?
}

model Notification {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target        String
  description   String
  type          Int      @default(0)
  image         String   @default("")
  location      String   @default("")
  locationLabel String   @default("")
  status        String   @default("")
  readed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([readed, createdAt])
}

// ΓöÇΓöÇΓöÇ Organisation stubs ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Company {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  warehouses Warehouse[]
  materials  MmMaterial[]

  inventoryTransactions  MmInventoryTransaction[]
  mmInventoryBalances    MmInventoryBalance[]
  inventoryReservations  MmInventoryReservation[]

  goodsReceipts          MmGoodsReceipt[]
  goodsIssues            MmGoodsIssue[]
  binTransfers           MmBinTransfer[]
  warehouseTransferOrders MmWarehouseTransferOrder[]
  inventoryAdjustments   MmInventoryAdjustment[]
  countRules             MmCountRule[]
  inventoryCounts        MmInventoryCount[]

  suppliers              MmSupplier[]

  purchaseRequisitions   MmPurchaseRequisition[]
  rfqs                   MmRfq[]
  purchaseOrders         MmPurchaseOrder[]
  purchaseContracts      MmPurchaseContract[]
  poToleranceConfigs     MmPoToleranceConfig[]
  asns                   MmAsn[]
  expectedReceipts       MmExpectedReceipt[]
  qualityInspections     MmQualityInspection[]
  accountingEvents       MmAccountingEvent[]

  materialValuations     MmMaterialValuation[]
  costLayers             MmCostLayer[]
  valuationTransactions  MmInventoryValuationTransaction[]
  standardCostRevisions  MmStandardCostRevision[]
  landedCosts            MmLandedCost[]
  supplierInvoices       MmSupplierInvoice[]
  mrpRuns                MmMrpRun[]
  reorderRules           MmReorderRule[]
  planningDemands        MmPlanningDemand[]
  materialRequirements   MmMaterialRequirement[]
  procurementSuggestions MmProcurementSuggestion[]
  supplierScoreWeightConfigs MmSupplierScoreWeightConfig[]
  supplierAlertConfigs   MmSupplierAlertConfig[]
  supplierEvaluations    MmSupplierEvaluation[]
  supplierAlerts         MmSupplierAlert[]
  supplierManualAssessments MmSupplierManualAssessment[]
  returnsDisposalConfigs MmReturnsDisposalConfig[]
  supplierReturns        MmSupplierReturn[]
  disposals              MmDisposal[]
  customerReturns        MmCustomerReturn[]
  scannerEvents          MmScannerEvent[]
  dashboardAnalyticsCaches MmDashboardAnalyticsCache[]
  plants                   Plant[]
  branches                 Branch[]

  @@map("companies")
}

model Plant {
  id        String   @id @default(cuid())
  code      String
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  warehouses Warehouse[]
  branches   Branch[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("plants")
}

model Branch {
  id        String   @id @default(cuid())
  code      String
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id])
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  warehouses Warehouse[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([plantId])
  @@map("branches")
}

model Warehouse {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  plantId              String?
  plant                Plant?   @relation(fields: [plantId], references: [id])
  branchId             String?
  branch               Branch?  @relation(fields: [branchId], references: [id])
  managerId            String?
  warehouseType        String?  @default("GENERAL")
  address              String?
  timezone             String?  @default("UTC")
  status               String   @default("ACTIVE")
  defaultReceivingArea String?
  defaultShippingArea  String?
  barcode              String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  materials            MmMaterial[]
  storageTypes         WmStorageType[]
  audits               WmWarehouseAudit[]
  putawayTasks         WmPutawayTask[]
  pickWaves            WmPickWave[]
  pickingTasks         WmPickingTask[]
  packages             WmPackage[]
  transfersOut         WmWarehouseTransfer[] @relation("TransferSource")
  transfersIn          WmWarehouseTransfer[] @relation("TransferDest")

  inventoryTransactions  MmInventoryTransaction[]
  mmInventoryBalances    MmInventoryBalance[]
  inventoryReservations  MmInventoryReservation[]

  goodsReceipts          MmGoodsReceipt[]
  goodsIssues            MmGoodsIssue[]
  binTransfers           MmBinTransfer[]
  wtoSource              MmWarehouseTransferOrder[] @relation("WtoSource")
  wtoDest                MmWarehouseTransferOrder[] @relation("WtoDest")
  inventoryAdjustments   MmInventoryAdjustment[]
  countRules             MmCountRule[]
  inventoryCounts        MmInventoryCount[]

  suppliersDefaultWh     MmSupplier[] @relation("SupplierDefaultWh")
  prLines                MmPurchaseRequisitionLine[] @relation("PrLineWarehouse")
  purchaseOrders         MmPurchaseOrder[] @relation("PoWarehouse")
  poLines                MmPurchaseOrderLine[] @relation("PoLineWarehouse")
  asns                   MmAsn[] @relation("AsnWarehouse")
  expectedReceipts       MmExpectedReceipt[] @relation("ExpectedReceiptWarehouse")

  materialValuations     MmMaterialValuation[]
  costLayers             MmCostLayer[]
  valuationTransactions  MmInventoryValuationTransaction[]
  standardCostRevisions  MmStandardCostRevision[]
  landedCosts            MmLandedCost[]
  mrpRuns                MmMrpRun[]
  reorderRules           MmReorderRule[]
  planningDemands        MmPlanningDemand[]
  materialRequirements   MmMaterialRequirement[]
  procurementSuggestions MmProcurementSuggestion[]
  supplierReturns        MmSupplierReturn[] @relation("ReturnWarehouse")
  disposals              MmDisposal[] @relation("DisposalWarehouse")
  customerReturns        MmCustomerReturn[] @relation("CustomerReturnWarehouse")
  scannerEvents          MmScannerEvent[]
  serialNumbersCurrent   MmSerialNumber[] @relation("SerialCurrentWarehouse")

  @@index([plantId])
  @@index([branchId])
  @@map("warehouses")
}

// ΓöÇΓöÇΓöÇ Warehouse Topology ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmStorageType {
  id                    String   @id @default(cuid())
  code                  String
  name                  String
  description           String?
  warehouseId           String
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id])
  temperatureControlled Boolean  @default(false)
  hazardous             Boolean  @default(false)
  pickingAllowed        Boolean  @default(true)
  putawayAllowed        Boolean  @default(true)
  receivingAllowed      Boolean  @default(false)
  shippingAllowed       Boolean  @default(false)
  qualityControlled     Boolean  @default(false)
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  sections              WmStorageSection[]

  @@unique([warehouseId, code])
  @@map("wm_storage_types")
}

model WmStorageSection {
  id            String        @id @default(cuid())
  code          String
  name          String
  description   String?
  storageTypeId String
  storageType   WmStorageType @relation(fields: [storageTypeId], references: [id])
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  bins          WmStorageBin[]

  @@unique([storageTypeId, code])
  @@map("wm_storage_sections")
}

model WmStorageBin {
  id               String           @id @default(cuid())
  code             String
  storageSectionId String
  storageSection   WmStorageSection @relation(fields: [storageSectionId], references: [id])
  barcode          String?          @unique
  capacityQuantity Decimal          @default(0)
  capacityWeight   Decimal          @default(0)
  capacityVolume   Decimal          @default(0)
  weightUom        String?
  volumeUom        String?
  pickingAllowed   Boolean          @default(true)
  putawayAllowed   Boolean          @default(true)
  status           String           @default("ACTIVE")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  inventoryBalances  WmInventoryBalance[]
  putawayRecommended WmPutawayTask[]      @relation("RecommendedBin")
  putawayActual      WmPutawayTask[]      @relation("ActualBin")
  pickingTasks       WmPickingTask[]
  transferLinesSource WmWarehouseTransferLine[] @relation("TransferSourceBin")
  transferLinesDest   WmWarehouseTransferLine[] @relation("TransferDestBin")

  invTransactions        MmInventoryTransaction[]
  mmInvBalances          MmInventoryBalance[]
  invReservations        MmInventoryReservation[]

  grLines                MmGoodsReceiptLine[] @relation("GrLineBin")
  giLines                MmGoodsIssueLine[] @relation("GiLineBin")
  btSourceLines          MmBinTransferLine[] @relation("BtLineSourceBin")
  btDestLines            MmBinTransferLine[] @relation("BtLineDestBin")
  wtoSourceLines         MmWarehouseTransferOrderLine[] @relation("WtoLineSourceBin")
  wtoDestLines           MmWarehouseTransferOrderLine[] @relation("WtoLineDestBin")
  adjLines               MmInventoryAdjustmentLine[] @relation("AdjLineBin")
  poLines                MmPurchaseOrderLine[] @relation("PoLineBin")
  countLines             MmInventoryCountLine[]
  serialNumbersCurrent   MmSerialNumber[] @relation("SerialCurrentBin")

  @@unique([storageSectionId, code])
  @@map("wm_storage_bins")
}

model WmWarehouseAudit {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  entityType  String
  entityId    String
  action      String
  changes     Json?
  performedBy String?
  performedAt DateTime  @default(now())

  @@index([warehouseId, performedAt])
  @@map("wm_warehouse_audits")
}

// ΓöÇΓöÇΓöÇ Inventory Balance (stub) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmInventoryBalance {
  id                String      @id @default(cuid())
  binId             String
  bin               WmStorageBin @relation(fields: [binId], references: [id])
  materialId        String
  material          MmMaterial  @relation(fields: [materialId], references: [id])
  batchId           String?
  serialId          String?
  quantity          Decimal     @default(0)
  reservedQuantity  Decimal     @default(0)
  availableQuantity Decimal     @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([binId, materialId, batchId, serialId])
  @@index([materialId])
  @@index([binId])
  @@map("wm_inventory_balances")
}

// ΓöÇΓöÇΓöÇ Putaway ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmPutawayTask {
  id              String       @id @default(cuid())
  taskNumber      String       @unique
  warehouseId     String
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id])
  companyId       String?
  sourceDocument  String?
  goodsReceiptId  String?
  goodsReceipt    MmGoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptLineId String?
  goodsReceiptLine MmGoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  materialId      String
  material        MmMaterial   @relation(fields: [materialId], references: [id])
  quantity        Decimal
  uomId           String?
  batchId         String?
  serialId        String?
  stockStatus     String       @default("UNRESTRICTED")
  sourceLocation  String?
  sourceBinId     String?
  recommendedBinId String?
  recommendedBin  WmStorageBin? @relation("RecommendedBin", fields: [recommendedBinId], references: [id])
  actualBinId     String?
  actualBin       WmStorageBin? @relation("ActualBin", fields: [actualBinId], references: [id])
  assignedWorker  String?
  priority        Int          @default(5)
  status          String       @default("PENDING")
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([warehouseId, status])
  @@index([status])
  @@index([goodsReceiptId])
  @@map("wm_putaway_tasks")
}

// ΓöÇΓöÇΓöÇ Picking ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmPickWave {
  id             String          @id @default(cuid())
  waveNumber     String          @unique
  warehouseId    String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  strategy       String          @default("FIFO") // FIFO | FEFO | ZONE | PRIORITY
  priority       Int             @default(5)
  status         String          @default("DRAFT")
  taskCount      Int             @default(0)
  completedCount Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tasks          WmPickingTask[]

  @@index([warehouseId, status])
  @@map("wm_pick_waves")
}

model WmPickingTask {
  id           String        @id @default(cuid())
  taskNumber   String        @unique
  waveId       String?
  wave         WmPickWave?   @relation(fields: [waveId], references: [id])
  warehouseId  String
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  companyId    String?
  reservationId String?
  reservation  MmInventoryReservation? @relation(fields: [reservationId], references: [id])
  sourceBinId  String
  sourceBin    WmStorageBin  @relation(fields: [sourceBinId], references: [id])
  materialId   String
  material     MmMaterial    @relation(fields: [materialId], references: [id])
  batchId      String?
  serialId     String?
  uomId        String?
  requiredQty  Decimal
  pickedQty    Decimal       @default(0)
  sourceDocument String?
  assignedUser String?
  priority     Int           @default(5)
  status       String        @default("OPEN")
  lastIdempotencyKey String? @unique
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  packages     WmPackage[]   @relation("PackageFromPick")

  @@index([warehouseId, status])
  @@index([waveId])
  @@index([reservationId])
  @@map("wm_picking_tasks")
}

// ΓöÇΓöÇΓöÇ Packing ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmPackage {
  id             String          @id @default(cuid())
  packageNumber  String          @unique
  orderNumber    String?
  warehouseId    String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  pickingTaskId  String?
  pickingTask    WmPickingTask?  @relation("PackageFromPick", fields: [pickingTaskId], references: [id])
  reservationId  String?
  reservation    MmInventoryReservation? @relation(fields: [reservationId], references: [id])
  packageType    String?
  weight         Decimal?
  length         Decimal?
  width          Decimal?
  height         Decimal?
  carrier        String?
  trackingNumber String?
  status         String          @default("OPEN") // OPEN | VERIFIED | SEALED | READY_FOR_DISPATCH | DISPATCHED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          WmPackageItem[]
  goodsIssues    MmGoodsIssue[]

  @@index([warehouseId, status])
  @@index([pickingTaskId])
  @@map("wm_packages")
}

model WmPackageItem {
  id          String     @id @default(cuid())
  packageId   String
  package     WmPackage  @relation(fields: [packageId], references: [id])
  materialId  String
  material    MmMaterial @relation(fields: [materialId], references: [id])
  expectedQty Decimal
  scannedQty  Decimal    @default(0)
  batchId     String?
  serialId    String?
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([packageId])
  @@map("wm_package_items")
}

// ΓöÇΓöÇΓöÇ Warehouse Transfers ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model WmWarehouseTransfer {
  id                     String                    @id @default(cuid())
  transferNumber         String                    @unique
  sourceWarehouseId      String
  sourceWarehouse        Warehouse                 @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse                 @relation("TransferDest", fields: [destinationWarehouseId], references: [id])
  requestedBy            String?
  approvedBy             String?
  status                 String                    @default("DRAFT")
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  lines                  WmWarehouseTransferLine[]

  @@index([status])
  @@map("wm_warehouse_transfers")
}

model WmWarehouseTransferLine {
  id               String              @id @default(cuid())
  transferId       String
  transfer         WmWarehouseTransfer @relation(fields: [transferId], references: [id])
  materialId       String
  material         MmMaterial          @relation(fields: [materialId], references: [id])
  quantity         Decimal
  batchId          String?
  serialId         String?
  sourceBinId      String?
  sourceBin        WmStorageBin?       @relation("TransferSourceBin", fields: [sourceBinId], references: [id])
  destinationBinId String?
  destinationBin   WmStorageBin?       @relation("TransferDestBin", fields: [destinationBinId], references: [id])
  pickedQty        Decimal             @default(0)
  receivedQty      Decimal             @default(0)
  status           String              @default("PENDING")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([transferId])
  @@map("wm_warehouse_transfer_lines")
}

// ΓöÇΓöÇΓöÇ MM Reference masters ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmMaterialType {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  materials   MmMaterial[]

  @@map("mm_material_types")
}

model MmMaterialCategory {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String?
  parentId    String?
  parent      MmMaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    MmMaterialCategory[] @relation("CategoryTree")
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  materials   MmMaterial[]
  purchaseContracts MmPurchaseContract[]

  @@map("mm_material_categories")
}

model MmUom {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  materialsBase     MmMaterial[]     @relation("BaseUom")
  materialsPurchase MmMaterial[]     @relation("PurchaseUom")
  materialsSales    MmMaterial[]     @relation("SalesUom")
  conversionsFrom   MmUomConversion[] @relation("ConvFrom")
  conversionsTo     MmUomConversion[] @relation("ConvTo")

  inventoryTransactions MmInventoryTransaction[]

  grLineUoms  MmGoodsReceiptLine[] @relation("GrLineUom")
  giLineUoms  MmGoodsIssueLine[] @relation("GiLineUom")
  btLineUoms  MmBinTransferLine[] @relation("BtLineUom")
  wtoLineUoms MmWarehouseTransferOrderLine[] @relation("WtoLineUom")
  adjLineUoms MmInventoryAdjustmentLine[] @relation("AdjLineUom")
  prLineUoms  MmPurchaseRequisitionLine[] @relation("PrLineUom")
  rfqLineUoms MmRfqLine[] @relation("RfqLineUom")
  quotationLineUoms MmSupplierQuotationLine[] @relation("QuotationLineUom")
  poLineUoms  MmPurchaseOrderLine[] @relation("PoLineUom")
  contractLineUoms MmPurchaseContractLine[] @relation("ContractLineUom")
  asnLineUoms MmAsnLine[] @relation("AsnLineUom")
  erLineUoms  MmExpectedReceiptLine[] @relation("ErLineUom")
  invoiceLineUoms MmSupplierInvoiceLine[] @relation("InvoiceLineUom")

  @@map("mm_uoms")
}

model MmUomConversion {
  id         String      @id @default(cuid())
  fromUomId  String
  fromUom    MmUom       @relation("ConvFrom", fields: [fromUomId], references: [id])
  toUomId    String
  toUom      MmUom       @relation("ConvTo", fields: [toUomId], references: [id])
  factor     Decimal
  materialId String?
  material   MmMaterial? @relation(fields: [materialId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@unique([fromUomId, toUomId, materialId])
  @@map("mm_uom_conversions")
}

model MmValuationClass {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  materials MmMaterial[]

  @@map("mm_valuation_classes")
}

model MmCurrency {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  symbol    String
  createdAt DateTime     @default(now())
  materials MmMaterial[]

  suppliers          MmSupplier[] @relation("SupplierCurrency")
  supplierMaterials  MmSupplierMaterial[] @relation("SupMatCurrency")
  supplierPrices     MmSupplierPrice[] @relation("SupPriceCurrency")
  rfqs               MmRfq[] @relation("RfqCurrency")
  quotations         MmSupplierQuotation[] @relation("QuotationCurrency")
  purchaseOrders     MmPurchaseOrder[] @relation("PoCurrency")
  purchaseContracts  MmPurchaseContract[] @relation("ContractCurrency")
  materialValuations MmMaterialValuation[]
  supplierInvoices   MmSupplierInvoice[] @relation("InvoiceCurrency")

  @@map("mm_currencies")
}

// ΓöÇΓöÇΓöÇ Core Material ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmMaterial {
  id               String  @id @default(cuid())
  materialCode     String  @unique
  materialName     String
  description      String?
  shortDescription String?
  sku              String? @unique
  brand            String?
  model            String?
  manufacturer     String?

  materialTypeId     String
  materialType       MmMaterialType     @relation(fields: [materialTypeId], references: [id])
  materialCategoryId String
  materialCategory   MmMaterialCategory @relation(fields: [materialCategoryId], references: [id])
  status             String             @default("DRAFT")

  baseUomId     String
  baseUom       MmUom   @relation("BaseUom", fields: [baseUomId], references: [id])
  purchaseUomId String?
  purchaseUom   MmUom?  @relation("PurchaseUom", fields: [purchaseUomId], references: [id])
  salesUomId    String?
  salesUom      MmUom?  @relation("SalesUom", fields: [salesUomId], references: [id])

  weight       Decimal?
  weightUom    String?
  length       Decimal?
  width        Decimal?
  height       Decimal?
  dimensionUom String?
  volume       Decimal?
  volumeUom    String?

  inventoryManaged           Boolean @default(true)
  purchasable                Boolean @default(true)
  sellable                   Boolean @default(true)
  batchManaged               Boolean @default(false)
  serialManaged              Boolean @default(false)
  negativeStockAllowed       Boolean @default(false)
  expiryManaged              Boolean @default(false)
  qualityInspectionRequired  Boolean @default(false)
  /// A | B | C ΓÇö cycle-count classification
  abcClass                   String?
  /// FAST | MEDIUM | SLOW ΓÇö cycle-count velocity
  velocityClass              String?
  /// LOW | MEDIUM | HIGH ΓÇö cycle-count risk
  riskClass                  String?

  minimumStock         Decimal @default(0)
  maximumStock         Decimal @default(0)
  safetyStock          Decimal @default(0)
  reorderPoint         Decimal @default(0)
  reorderQuantity      Decimal @default(0)
  leadTimeDays         Int     @default(0)
  minimumOrderQuantity Decimal @default(0)

  valuationMethod  String?
  standardCost     Decimal          @default(0)
  currencyId       String?
  currency         MmCurrency?      @relation(fields: [currencyId], references: [id])
  valuationClassId String?
  valuationClass   MmValuationClass? @relation(fields: [valuationClassId], references: [id])

  companyId          String?
  company            Company?   @relation(fields: [companyId], references: [id])
  defaultWarehouseId String?
  defaultWarehouse   Warehouse? @relation(fields: [defaultWarehouseId], references: [id])

  preferredSupplierId String?
  preferredSupplier   MmSupplier? @relation("MaterialPreferredSupplier", fields: [preferredSupplierId], references: [id])

  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  barcodes       MmBarcode[]
  batches        MmBatch[]
  serialNumbers  MmSerialNumber[]
  audits         MmMaterialAudit[]
  attachments    MmMaterialAttachment[]
  uomConversions MmUomConversion[]
  inventoryBalances WmInventoryBalance[]
  putawayTasks      WmPutawayTask[]
  pickingTasks      WmPickingTask[]
  packageItems      WmPackageItem[]
  transferLines     WmWarehouseTransferLine[]

  inventoryTransactions  MmInventoryTransaction[]
  mmInventoryBalances    MmInventoryBalance[]
  inventoryReservations  MmInventoryReservation[]

  grLines                MmGoodsReceiptLine[]
  giLines                MmGoodsIssueLine[]
  btLines                MmBinTransferLine[]
  wtoLines               MmWarehouseTransferOrderLine[]
  adjLines               MmInventoryAdjustmentLine[]
  supplierMaterials      MmSupplierMaterial[]
  supplierPrices         MmSupplierPrice[]
  prLines                MmPurchaseRequisitionLine[]
  rfqLines               MmRfqLine[]
  quotationLines         MmSupplierQuotationLine[]
  poLines                MmPurchaseOrderLine[]
  purchaseContractLines  MmPurchaseContractLine[]
  asnLines               MmAsnLine[]
  expectedReceiptLines   MmExpectedReceiptLine[]
  countLines             MmInventoryCountLine[]

  materialValuations     MmMaterialValuation[]
  costLayers             MmCostLayer[]
  valuationTransactions  MmInventoryValuationTransaction[]
  standardCostRevisions  MmStandardCostRevision[]
  landedCostLines        MmLandedCostLine[]
  landedCostAllocations  MmLandedCostAllocation[]
  supplierInvoiceLines   MmSupplierInvoiceLine[]
  reorderRules           MmReorderRule[]
  planningDemands        MmPlanningDemand[]
  materialRequirements   MmMaterialRequirement[]
  procurementSuggestions MmProcurementSuggestion[]
  supplierReturnLines    MmSupplierReturnLine[]
  disposalLines          MmDisposalLine[]
  customerReturnLines    MmCustomerReturnLine[]

  @@index([status])
  @@index([materialTypeId])
  @@index([materialCategoryId])
  @@index([abcClass])
  @@index([deletedAt])
  @@map("mm_materials")
}

// ΓöÇΓöÇΓöÇ Material dependents ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmBarcode {
  id           String     @id @default(cuid())
  materialId   String
  material     MmMaterial @relation(fields: [materialId], references: [id])
  barcodeType  String
  barcodeValue String     @unique
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([materialId])
  @@map("mm_barcodes")
}

model MmBatch {
  id                String           @id @default(cuid())
  materialId        String
  material          MmMaterial       @relation(fields: [materialId], references: [id])
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  supplierId        String?
  supplier          MmSupplier?      @relation(fields: [supplierId], references: [id])
  status            String           @default("AVAILABLE")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  serialNumbers     MmSerialNumber[]

  inventoryTransactions  MmInventoryTransaction[]
  mmInventoryBalances    MmInventoryBalance[]
  inventoryReservations  MmInventoryReservation[]

  grLines                MmGoodsReceiptLine[] @relation("GrLineBatch")
  giLines                MmGoodsIssueLine[] @relation("GiLineBatch")
  btLines                MmBinTransferLine[] @relation("BtLineBatch")
  wtoLines               MmWarehouseTransferOrderLine[] @relation("WtoLineBatch")
  adjLines               MmInventoryAdjustmentLine[] @relation("AdjLineBatch")

  @@unique([materialId, batchNumber])
  @@index([materialId])
  @@index([supplierId])
  @@map("mm_batches")
}

model MmSerialNumber {
  id                  String         @id @default(cuid())
  materialId          String
  material            MmMaterial     @relation(fields: [materialId], references: [id])
  serialNumber        String
  batchId             String?
  batch               MmBatch?       @relation(fields: [batchId], references: [id])
  currentWarehouseId  String?
  currentWarehouse    Warehouse?     @relation("SerialCurrentWarehouse", fields: [currentWarehouseId], references: [id])
  currentBinId        String?
  currentBin          WmStorageBin?  @relation("SerialCurrentBin", fields: [currentBinId], references: [id])
  status              String         @default("AVAILABLE")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  inventoryTransactions  MmInventoryTransaction[]
  mmInventoryBalances    MmInventoryBalance[]
  inventoryReservations  MmInventoryReservation[]

  grLines                MmGoodsReceiptLine[] @relation("GrLineSerial")
  giLines                MmGoodsIssueLine[] @relation("GiLineSerial")
  btLines                MmBinTransferLine[] @relation("BtLineSerial")
  wtoLines               MmWarehouseTransferOrderLine[] @relation("WtoLineSerial")
  adjLines               MmInventoryAdjustmentLine[] @relation("AdjLineSerial")

  @@unique([materialId, serialNumber])
  @@index([materialId])
  @@index([currentWarehouseId])
  @@index([currentBinId])
  @@map("mm_serial_numbers")
}

// ΓöÇΓöÇΓöÇ Material audit trail ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmMaterialAudit {
  id          String     @id @default(cuid())
  materialId  String
  material    MmMaterial @relation(fields: [materialId], references: [id])
  action      String
  changes     Json?
  performedBy String?
  performedAt DateTime   @default(now())

  @@index([materialId, performedAt])
  @@map("mm_material_audits")
}

model MmMaterialAttachment {
  id          String     @id @default(cuid())
  materialId  String
  material    MmMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String?
  storageKey  String?
  mimeType    String?
  uploadedBy  String?
  uploadedAt  DateTime   @default(now())

  @@index([materialId])
  @@map("mm_material_attachments")
}

// ΓöÇΓöÇΓöÇ Inventory Ledger ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmInventoryTransaction {
  id                    String    @id @default(cuid())
  transactionNumber     String    @unique
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  plantId               String?
  warehouseId           String
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id])
  storageBinId          String?
  storageBin            WmStorageBin? @relation(fields: [storageBinId], references: [id])
  materialId            String
  material              MmMaterial @relation(fields: [materialId], references: [id])
  batchId               String?
  batch                 MmBatch?   @relation(fields: [batchId], references: [id])
  serialNumberId        String?
  serialNumber          MmSerialNumber? @relation(fields: [serialNumberId], references: [id])
  stockStatus           String    @default("UNRESTRICTED")
  movementType          String
  quantity              Decimal
  /// Absolute quantity in base UOM (same magnitude as quantity for normal posts)
  baseQuantity          Decimal   @default(0)
  /// Signed quantity in base UOM (+ inbound / ΓêÆ outbound)
  signedQuantity        Decimal   @default(0)
  uomId                 String
  uom                   MmUom     @relation(fields: [uomId], references: [id])
  unitCost              Decimal   @default(0)
  totalCost             Decimal   @default(0)
  postingDate           DateTime
  documentDate          DateTime
  sourceModule          String?
  sourceDocumentType    String?
  sourceDocumentId      String?
  sourceDocumentLineId  String?
  reasonCode            String?
  remarks               String?
  reversalOfId          String?   @unique
  reversalOf            MmInventoryTransaction? @relation("TxnReversal", fields: [reversalOfId], references: [id])
  reversedBy            MmInventoryTransaction? @relation("TxnReversal")
  idempotencyKey        String?   @unique
  createdBy             String?
  createdAt             DateTime  @default(now())

  audit                 MmInventoryAudit[]
  costLayers            MmCostLayer[]
  valuationTransaction  MmInventoryValuationTransaction?

  @@index([materialId])
  @@index([warehouseId])
  @@index([postingDate])
  @@index([sourceDocumentId])
  @@index([companyId])
  @@map("mm_inventory_transactions")
}

model MmInventoryBalance {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  storageBinId      String?
  storageBin        WmStorageBin? @relation(fields: [storageBinId], references: [id])
  materialId        String
  material          MmMaterial @relation(fields: [materialId], references: [id])
  batchId           String?
  batch             MmBatch?   @relation(fields: [batchId], references: [id])
  serialNumberId    String?
  serialNumber      MmSerialNumber? @relation(fields: [serialNumberId], references: [id])
  stockStatus       String    @default("UNRESTRICTED")
  quantity          Decimal   @default(0)
  reservedQuantity  Decimal   @default(0)
  availableQuantity Decimal   @default(0)
  version           Int       @default(0)
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, warehouseId, storageBinId, materialId, batchId, serialNumberId, stockStatus])
  @@index([materialId])
  @@index([warehouseId])
  @@map("mm_inventory_balances")
}

model MmInventoryReservation {
  id                    String    @id @default(cuid())
  reservationNumber     String    @unique
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  warehouseId           String
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id])
  storageBinId          String?
  storageBin            WmStorageBin? @relation(fields: [storageBinId], references: [id])
  materialId            String
  material              MmMaterial @relation(fields: [materialId], references: [id])
  batchId               String?
  batch                 MmBatch?   @relation(fields: [batchId], references: [id])
  serialNumberId        String?
  serialNumber          MmSerialNumber? @relation(fields: [serialNumberId], references: [id])
  stockStatus           String    @default("UNRESTRICTED")
  /// Requested / reserved allocation (does not change on-hand quantity)
  quantity              Decimal
  reservedQuantity      Decimal   @default(0)
  fulfilledQuantity     Decimal   @default(0)
  /// SALES_ORDER | PRODUCTION_ORDER | MAINTENANCE_ORDER | INTERNAL_REQUEST | PROJECT
  sourceType            String    @default("INTERNAL_REQUEST")
  sourceModule          String
  sourceDocumentType    String
  sourceDocumentId      String
  sourceDocumentLineId  String?
  /// OPEN | PARTIAL | FULFILLED | CANCELLED | EXPIRED
  status                String    @default("OPEN")
  validUntil            DateTime?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  pickingTasks          WmPickingTask[]
  packages              WmPackage[]
  goodsIssues           MmGoodsIssue[]

  @@index([materialId])
  @@index([warehouseId])
  @@index([sourceDocumentId])
  @@index([status])
  @@map("mm_inventory_reservations")
}

model MmInventoryAudit {
  id            String   @id @default(cuid())
  transactionId String
  transaction   MmInventoryTransaction @relation(fields: [transactionId], references: [id])
  action        String
  changes       Json?
  performedBy   String?
  performedAt   DateTime @default(now())

  @@index([transactionId])
  @@map("mm_inventory_audits")
}

// ΓöÇΓöÇΓöÇ Stock Operations Documents ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model MmGoodsReceipt {
  id             String   @id @default(cuid())
  documentNumber String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  purchaseOrderId String?
  purchaseOrder   MmPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  expectedReceiptId String?
  expectedReceipt   MmExpectedReceipt? @relation(fields: [expectedReceiptId], references: [id])
  asnId          String?
  asn            MmAsn? @relation(fields: [asnId], references: [id])
  supplierId     String?
  supplier       MmSupplier? @relation("GrSupplier", fields: [supplierId], references: [id])
  postingDate    DateTime
  documentDate   DateTime
  stockStatus    String   @default("UNRESTRICTED")
  remarks        String?
  createdBy      String?
  receiverId     String?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines          MmGoodsReceiptLine[]
  qualityInspections MmQualityInspection[]
  putawayTasks   WmPutawayTask[]
  supplierReturns MmSupplierReturn[]

  @@index([status])
  @@index([warehouseId])
  @@index([purchaseOrderId])
  @@index([expectedReceiptId])
  @@map("mm_goods_receipts")
}

model MmGoodsReceiptLine {
  id             String   @id @default(cuid())
  receiptId      String
  receipt        MmGoodsReceipt @relation(fields: [receiptId], references: [id])
  materialId     String
  material       MmMaterial @relation(fields: [materialId], references: [id])
  quantity       Decimal
  expectedQuantity Decimal?
  shortageQuantity Decimal @default(0)
  overageQuantity  Decimal @default(0)
  damagedQuantity  Decimal @default(0)
  rejectedQuantity Decimal @default(0)
  uomId          String
  uom            MmUom    @relation("GrLineUom", fields: [uomId], references: [id])
  storageBinId   String?
  storageBin     WmStorageBin? @relation("GrLineBin", fields: [storageBinId], references: [id])
  batchId        String?
  batch          MmBatch? @relation("GrLineBatch", fields: [batchId], references: [id])
  serialNumberId String?
  serialNumber   MmSerialNumber? @relation("GrLineSerial", fields: [serialNumberId], references: [id])
  unitCost       Decimal  @default(0)
  totalCost      Decimal  @default(0)
  stockStatus    String?
  remarks        String?
  purchaseOrderLineId String?
  purchaseOrderLine   MmPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  expectedReceiptLineId String?
  expectedReceiptLine   MmExpectedReceiptLine? @relation(fields: [expectedReceiptLineId], references: [id])
  discrepancyFlag String?
  putawayTasks   WmPutawayTask[]
  qualityInspectionLines MmQualityInspectionLine[]
  invoiceLineReceipts MmSupplierInvoiceLineReceipt[]
  supplierReturnLines MmSupplierReturnLine[]

  @@index([receiptId])
  @@index([purchaseOrderLineId])
  @@map("mm_goods_receipt_lines")
}

model MmGoodsIssue {
  id             String   @id @default(cuid())
  documentNumber String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  reservationId  String?
  reservation    MmInventoryReservation? @relation(fields: [reservationId], references: [id])
  packageId      String?
  package        WmPackage? @relation(fields: [packageId], references: [id])
  sourceDocumentType String?
  sourceDocumentId   String?
  postingDate    DateTime
  documentDate   DateTime
  issuePurpose   String   @default("INTERNAL")
  remarks        String?
  createdBy      String?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines          MmGoodsIssueLine[]

  @@index([status])
  @@index([warehouseId])
  @@index([reservationId])
  @@index([packageId])
  @@map("mm_goods_issues")
}

model MmGoodsIssueLine {
  id             String   @id @default(cuid())
  issueId        String
  issue          MmGoodsIssue @relation(fields: [issueId], references: [id])
  materialId     String
  material       MmMaterial @relation(fields: [materialId], references: [id])
  quantity       Decimal
  uomId          String
