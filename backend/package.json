{
  "name": "agctek-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "AGCTEK ERP backend API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:seed-mm-purge": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-reset.ts",
    "prisma:seed-sd-purge": "ts-node --project prisma/tsconfig.seed.json prisma/seed-sd-purge.ts",
    "prisma:purge-sd-mm-keep-uom": "ts-node --project prisma/tsconfig.seed.json prisma/seed-sd-mm-purge-keep-uom.ts",
    "prisma:seed-org-warehouse": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-org-warehouse.ts",
    "prisma:repair-order-companies": "ts-node --project prisma/tsconfig.seed.json prisma/repair-order-companies.ts",
    "prisma:seed-mm-reference": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-reference-essentials-run.ts",
    "prisma:seed-material-samples": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-material-samples-run.ts",
    "prisma:seed-supplier-links": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-supplier-material-links-run.ts",
    "prisma:seed-purchase-requisition": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-purchase-requisition-run.ts",
    "prisma:delete-procurement-docs": "ts-node --project prisma/tsconfig.seed.json prisma/delete-procurement-documents-run.ts",
    "prisma:purge-demo-procurement-20261006": "ts-node --project prisma/tsconfig.seed.json prisma/purge-demo-procurement-20261006-run.ts",
    "prisma:delete-goods-receipts": "ts-node --project prisma/tsconfig.seed.json prisma/delete-goods-receipts-run.ts",
    "prisma:remove-org-plants": "ts-node --project prisma/tsconfig.seed.json prisma/remove-org-plants-run.ts",
    "prisma:sync-material-stock": "ts-node --project prisma/tsconfig.seed.json prisma/sync-material-stock-from-ledger-run.ts",
    "prisma:seed-scm-demo": "ts-node --project prisma/tsconfig.seed.json prisma/seed-mm-scm-reset.ts",
    "prisma:seed-demand-plan": "ts-node --project prisma/tsconfig.seed.json prisma/seed-scm-demand-plan.ts",
    "prisma:seed-tms": "ts-node --project prisma/tsconfig.seed.json prisma/seed-scm-tms.ts",
    "prisma:seed-crm-temp": "ts-node --transpile-only --project prisma/tsconfig.seed.json prisma/seed-crm-temp.ts",
    "prisma:clean-crm-temp": "ts-node --transpile-only --project prisma/tsconfig.seed.json prisma/seed-crm-temp.ts --clean",
    "test": "jest --runInBand --forceExit",
    "test:architecture": "jest src/mm/architecture --runInBand --forceExit",
    "test:pg": "jest --runInBand --forceExit --testRegex \"\\.pg-spec\\.ts$\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.[tj]s$": "ts-jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs/event-emitter|eventemitter2)/)"
    ]
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^22.10.5",
    "@types/socket.io": "^3.0.1",
    "jest": "^30.5.1",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
