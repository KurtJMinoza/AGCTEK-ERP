# Copy to .env.local (not committed). Used at `npm run build` for NEXT_PUBLIC_* vars.

AUTH_URL=http://localhost:3010
NEXT_PUBLIC_API_BASE_URL=http://localhost:3011

# Optional if you prefer build-time Google GIS (otherwise backend GOOGLE_CLIENT_ID is loaded at runtime).
# Must match backend GOOGLE_CLIENT_ID — OAuth "Web application" client from Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3010
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
